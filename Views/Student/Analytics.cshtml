@model StudentAnalyticsViewModel
@{
    ViewData["Title"] = "My Analytics";
}

<div class="page-header">
    <div>
        <h1>My Analytics</h1>
        <p class="page-subtitle">A visual overview of your academic performance</p>
    </div>
</div>

<!-- Loading state -->
<div id="analyticsLoading" class="card">
    <div class="card-body text-center py-5">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="text-muted mb-0">Loading your analytics…</p>
    </div>
</div>

<!-- Error state -->
<div id="analyticsError" class="card" style="display:none">
    <div class="empty-state">
        <div class="empty-icon" style="background:var(--danger-soft);color:var(--danger)"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h5>Could not load analytics</h5>
        <p>Something went wrong while fetching your data.</p>
        <button type="button" class="btn btn-primary" onclick="location.reload()"><i class="fa-solid fa-rotate-right me-2"></i>Retry</button>
    </div>
</div>

<!-- Content -->
<div id="analyticsContent" style="display:none">
    <div class="row g-3 mb-4" id="statCards"></div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header"><h6 class="card-title">Course Progress &amp; Quiz Averages</h6></div>
                <div class="card-body">
                    <div class="chart-container" style="height:280px"><canvas id="courseChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header"><h6 class="card-title">Attendance Split</h6></div>
                <div class="card-body">
                    <div class="chart-container" style="height:280px"><canvas id="attendanceChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header"><h6 class="card-title">GPA by Course (semester results)</h6></div>
                <div class="card-body">
                    <div class="chart-container" style="height:260px"><canvas id="gpaChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header"><h6 class="card-title">Monthly Attendance</h6></div>
                <div class="card-body">
                    <div class="chart-container" style="height:260px"><canvas id="monthChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#64748b';

        function statCard(icon, color, value, label) {
            return '<div class="col-6 col-xl-3"><div class="card stat-card">' +
                '<span class="stat-icon ' + color + '"><i class="fa-solid ' + icon + '"></i></span>' +
                '<div><div class="stat-value">' + value + '</div><div class="stat-label">' + label + '</div></div>' +
                '</div></div>';
        }

        fetch('/api/student/analytics-data')
            .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
            .then(function (data) {
                document.getElementById('analyticsLoading').style.display = 'none';
                document.getElementById('analyticsContent').style.display = '';

                const att = data.attendanceSummary;
                const avgProgress = data.enrollments.length
                    ? Math.round(data.enrollments.reduce((s, e) => s + (e.progressPercentage || 0), 0) / data.enrollments.length)
                    : 0;
                const gpaValues = data.semesterResults.map(r => r.gpa);
                const avgGpa = gpaValues.length ? (gpaValues.reduce((a, b) => a + b, 0) / gpaValues.length).toFixed(2) : '—';

                document.getElementById('statCards').innerHTML =
                    statCard('fa-book-open', 'primary', data.enrollments.length, 'Enrolled Courses') +
                    statCard('fa-bars-progress', 'info', avgProgress + '%', 'Avg. Progress') +
                    statCard('fa-calendar-check', 'success', att.attendancePercentage + '%', 'Attendance') +
                    statCard('fa-award', 'warning', avgGpa, 'Average GPA');

                /* Course progress + quiz averages */
                new Chart(document.getElementById('courseChart'), {
                    type: 'bar',
                    data: {
                        labels: data.enrollments.map(e => e.courseName),
                        datasets: [
                            { label: 'Progress %', data: data.enrollments.map(e => e.progressPercentage || 0), backgroundColor: '#4f46e5', borderRadius: 5, maxBarThickness: 26 },
                            { label: 'Quiz Avg %', data: data.enrollments.map(e => e.quizAverageScore || 0), backgroundColor: '#0284c7', borderRadius: 5, maxBarThickness: 26 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } },
                        scales: { y: { beginAtZero: true, max: 100, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
                    }
                });

                /* Attendance doughnut */
                new Chart(document.getElementById('attendanceChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Present', 'Absent', 'Leave'],
                        datasets: [{ data: [att.presentDays, att.absentDays, att.leaveDays], backgroundColor: ['#16a34a', '#dc2626', '#d97706'], borderWidth: 0 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: '65%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } }
                    }
                });

                /* GPA per semester-course */
                new Chart(document.getElementById('gpaChart'), {
                    type: 'bar',
                    data: {
                        labels: data.semesterResults.map(r => r.courseName + ' (' + r.semester.split(' ')[0] + ')'),
                        datasets: [{ label: 'GPA', data: data.semesterResults.map(r => r.gpa), backgroundColor: '#4f46e5', borderRadius: 5, maxBarThickness: 22 }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, max: 4, grid: { color: '#f1f5f9' } }, y: { grid: { display: false }, ticks: { font: { size: 10 } } } }
                    }
                });

                /* Monthly attendance stacked */
                new Chart(document.getElementById('monthChart'), {
                    type: 'bar',
                    data: {
                        labels: data.attendanceByMonth.map(m => m.month),
                        datasets: [
                            { label: 'Present', data: data.attendanceByMonth.map(m => m.present), backgroundColor: '#16a34a', borderRadius: 4, maxBarThickness: 26 },
                            { label: 'Absent', data: data.attendanceByMonth.map(m => m.absent), backgroundColor: '#dc2626', borderRadius: 4, maxBarThickness: 26 },
                            { label: 'Leave', data: data.attendanceByMonth.map(m => m.leave), backgroundColor: '#d97706', borderRadius: 4, maxBarThickness: 26 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } },
                        scales: {
                            x: { stacked: true, grid: { display: false } },
                            y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }
                        }
                    }
                });
            })
            .catch(function () {
                document.getElementById('analyticsLoading').style.display = 'none';
                document.getElementById('analyticsError').style.display = '';
            });
    </script>
}
