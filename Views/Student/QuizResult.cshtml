@model QuizResult
@{
    ViewData["Title"] = "Quiz Result";
    var pct = Math.Round(Model.PercentageScore);
    var circumference = 2 * Math.PI * 62;
    var dashOffset = circumference * (1 - Model.PercentageScore / 100.0);
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@Model.Quiz?.CourseId">@Model.Quiz?.Course?.Title</a></li>
                <li class="breadcrumb-item active">Result</li>
            </ol>
        </nav>
        <h1>Quiz Result</h1>
        <p class="page-subtitle">@Model.Quiz?.Title · attempted @Model.AttemptedAt.ToString("dd MMM yyyy, HH:mm")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card text-center">
            <div class="card-body p-4">
                <div class="score-ring mb-3">
                    <svg width="150" height="150" viewBox="0 0 150 150">
                        <circle class="ring-bg" cx="75" cy="75" r="62"></circle>
                        <circle class="ring-fill @(Model.IsPassed ? "" : "fail")" cx="75" cy="75" r="62"
                                stroke-dasharray="@circumference.ToString("0.##")"
                                stroke-dashoffset="@dashOffset.ToString("0.##")"></circle>
                    </svg>
                    <div class="ring-label">
                        <span class="value">@pct%</span>
                        <span class="text-muted" style="font-size:.8rem">Score</span>
                    </div>
                </div>

                @if (Model.IsPassed)
                {
                    <h4 class="text-success mb-1"><i class="fa-solid fa-trophy me-2"></i>Congratulations!</h4>
                    <p class="text-muted">You passed the quiz.</p>
                }
                else
                {
                    <h4 class="mb-1" style="color:var(--danger)"><i class="fa-solid fa-heart-crack me-2"></i>Not quite there</h4>
                    <p class="text-muted">You needed @Model.Quiz?.PassingMarks% to pass — review the material and try again.</p>
                }

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a class="btn btn-outline-primary" asp-action="TakeQuiz" asp-route-quizId="@Model.QuizId"><i class="fa-solid fa-rotate-right me-2"></i>Retake</a>
                    <a class="btn btn-primary" asp-action="CourseDetails" asp-route-id="@Model.Quiz?.CourseId"><i class="fa-solid fa-arrow-right me-2"></i>Back to Course</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h6 class="card-title">Breakdown</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded" style="background:var(--bg)">
                            <div class="stat-value">@Model.MarksObtained</div>
                            <div class="stat-label">Marks Scored</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded" style="background:var(--bg)">
                            <div class="stat-value">@Model.TotalMarks</div>
                            <div class="stat-label">Total Marks</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded" style="background:var(--bg)">
                            <div class="stat-value">@(Model.Quiz?.Questions?.Count ?? 0)</div>
                            <div class="stat-label">Questions</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded" style="background:var(--bg)">
                            <div class="stat-value">@(Model.DurationTakenInSeconds > 0 ? $"{Model.DurationTakenInSeconds / 60}:{Model.DurationTakenInSeconds % 60:00}" : "—")</div>
                            <div class="stat-label">Time Taken</div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted" style="font-size:.88rem">Passing threshold</span>
                    <span class="fw-semibold" style="font-size:.88rem">@Model.Quiz?.PassingMarks%</span>
                </div>
                <div class="progress mb-3" style="height:10px; position:relative">
                    <div class="progress-bar @(Model.IsPassed ? "bg-success" : "")" style="width:@(Model.PercentageScore)%"></div>
                </div>
                <p class="text-muted mb-0" style="font-size:.85rem">
                    <i class="fa-solid fa-lightbulb me-1 text-warning"></i>
                    You can retake this quiz any time — your best score counts toward course progress.
                </p>
            </div>
        </div>
    </div>
</div>
