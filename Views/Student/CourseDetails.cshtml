@model StudentCourseViewModel
@{
    var course = Model.Course;
    ViewData["Title"] = course.Title;
    var topics = course.Topics?.OrderBy(t => t.CreatedAt).ToList() ?? new List<Topic>();
    var materials = course.Materials?.OrderBy(m => m.UploadedAt).ToList() ?? new List<Material>();
    var quizzes = course.Quizzes?.Where(q => q.IsActive).OrderBy(q => q.CreatedAt).ToList() ?? new List<Quiz>();
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">@course.Title</li>
            </ol>
        </nav>
        <h1>@course.Title</h1>
        <p class="page-subtitle">
            <span class="badge badge-soft-muted me-2">@course.Category</span>
            <i class="fa-solid fa-chalkboard-user me-1"></i>@(course.Faculty?.FullName ?? "Faculty")
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold" style="font-size:.9rem">Course progress</span>
                    <span class="fw-semibold" id="progressLabel" style="font-size:.9rem">@Model.ProgressPercentage.ToString("0")%</span>
                </div>
                <div class="progress" style="height:10px">
                    <div class="progress-bar @(Model.ProgressPercentage >= 100 ? "bg-success" : "")" id="progressBar" style="width:@(Model.ProgressPercentage)%"></div>
                </div>
            </div>
            @if (Model.Enrollment.IsCompleted)
            {
                <span class="badge badge-soft-success" style="font-size:.85rem"><i class="fa-solid fa-trophy me-1"></i>Completed</span>
            }
        </div>
        <p class="text-muted mb-0" style="font-size:.92rem">@course.Description</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Topics -->
        <div class="card mb-4">
            <div class="card-header"><h6 class="card-title"><i class="fa-solid fa-list me-2 text-primary"></i>Topics</h6></div>
            @if (topics.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No topics have been added yet.</p></div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var (topic, index) in topics.Select((t, i) => (t, i)))
                    {
                        var isDone = Model.CompletedTopicIds.Contains(topic.Id);
                        <li class="list-group-item d-flex align-items-center gap-3 py-3" style="border-color:#f1f5f9">
                            <span class="avatar" style="width:32px;height:32px;font-size:.8rem; @(isDone ? "background:var(--success-soft);color:var(--success)" : "")">
                                @if (isDone)
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                                else
                                {
                                    @(index + 1)
                                }
                            </span>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="fw-medium">@topic.Name</div>
                                <div class="text-muted" style="font-size:.83rem">@topic.Description</div>
                            </div>
                            @if (!string.IsNullOrEmpty(topic.PdfFilePath))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@topic.PdfFilePath" target="_blank" title="Open PDF"><i class="fa-solid fa-file-pdf"></i></a>
                            }
                            @if (!isDone)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success mark-complete-btn" data-topic-id="@topic.Id" title="Mark as complete">
                                    <i class="fa-solid fa-check me-1"></i>Done
                                </button>
                            }
                            else
                            {
                                <span class="badge badge-soft-success">Completed</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Materials -->
        <div class="card mb-4">
            <div class="card-header"><h6 class="card-title"><i class="fa-solid fa-file-lines me-2 text-info"></i>Study Materials</h6></div>
            @if (materials.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No materials have been shared yet.</p></div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var material in materials)
                    {
                        var isDone = Model.CompletedMaterialIds.Contains(material.Id);
                        var icon = material.FileType switch
                        {
                            "PDF" => "fa-file-pdf text-danger",
                            "Video" => "fa-file-video text-primary",
                            "Image" => "fa-file-image text-success",
                            "Text" => "fa-file-pen text-info",
                            _ => "fa-file text-secondary",
                        };
                        <li class="list-group-item d-flex align-items-center gap-3 py-3" style="border-color:#f1f5f9">
                            <i class="fa-solid @icon fa-lg" style="width:24px;text-align:center"></i>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="fw-medium">@material.Title</div>
                                <span class="text-muted" style="font-size:.8rem">@material.FileType · added @material.UploadedAt.ToString("dd MMM yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(material.FilePath))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@material.FilePath" target="_blank"><i class="fa-solid fa-up-right-from-square me-1"></i>Open</a>
                            }
                            else if (material.FileType == "Text")
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal" data-bs-target="#materialModal"
                                        data-title="@material.Title" data-content="@material.Description">
                                    <i class="fa-solid fa-book-open me-1"></i>Read
                                </button>
                            }
                            @if (!isDone)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success mark-complete-btn" data-material-id="@material.Id" title="Mark as complete">
                                    <i class="fa-solid fa-check me-1"></i>Done
                                </button>
                            }
                            else
                            {
                                <span class="badge badge-soft-success">Completed</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Quizzes -->
        <div class="card">
            <div class="card-header"><h6 class="card-title"><i class="fa-solid fa-list-check me-2 text-warning"></i>Quizzes</h6></div>
            @if (quizzes.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No quizzes are available yet.</p></div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var quiz in quizzes)
                    {
                        var best = Model.BestQuizResults.GetValueOrDefault(quiz.Id);
                        var attempts = Model.QuizAttemptCounts.GetValueOrDefault(quiz.Id);
                        <li class="list-group-item py-3" style="border-color:#f1f5f9">
                            <div class="fw-medium mb-1">@quiz.Title</div>
                            <div class="text-muted mb-2" style="font-size:.8rem">
                                @(quiz.Questions?.Count ?? 0) questions · @quiz.TotalMarks marks · @quiz.DurationInMinutes min · pass @quiz.PassingMarks%
                            </div>
                            @if (best != null)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge @(best.IsPassed ? "badge-soft-success" : "badge-soft-danger")">
                                        Best: @best.PercentageScore.ToString("0")% @(best.IsPassed ? "· Passed" : "· Failed")
                                    </span>
                                    <span class="text-muted" style="font-size:.78rem">@attempts attempt@(attempts == 1 ? "" : "s")</span>
                                </div>
                            }
                            <a class="btn btn-sm @(best == null ? "btn-primary" : "btn-outline-primary") w-100" asp-action="TakeQuiz" asp-route-quizId="@quiz.Id">
                                <i class="fa-solid @(best == null ? "fa-play" : "fa-rotate-right") me-1"></i>@(best == null ? "Start Quiz" : "Retake Quiz")
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<!-- Text material reader modal -->
<div class="modal fade" id="materialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="materialModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="materialModalBody" style="white-space:pre-wrap; font-size:.93rem"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const materialModal = document.getElementById('materialModal');
        materialModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            materialModal.querySelector('#materialModalTitle').textContent = btn.dataset.title;
            materialModal.querySelector('#materialModalBody').textContent = btn.dataset.content;
        });

        document.querySelectorAll('.mark-complete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                const params = btn.dataset.topicId
                    ? 'topicId=' + btn.dataset.topicId
                    : 'materialId=' + btn.dataset.materialId;
                fetch('@Url.Action("MarkComplete")?' + params + '&courseId=@course.Id', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': App.token() }
                })
                .then(r => { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (data) {
                    const badge = document.createElement('span');
                    badge.className = 'badge badge-soft-success';
                    badge.textContent = 'Completed';
                    btn.replaceWith(badge);
                    if (typeof data.progress === 'number') {
                        document.getElementById('progressLabel').textContent = Math.round(data.progress) + '%';
                        document.getElementById('progressBar').style.width = data.progress + '%';
                    }
                    App.toast('Marked as complete — progress updated!', 'success');
                })
                .catch(function () {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Done';
                    App.toast('Could not update progress. Please try again.', 'error');
                });
            });
        });
    </script>
}
