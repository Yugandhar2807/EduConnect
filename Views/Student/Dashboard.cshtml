@model StudentDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="page-header">
    <div>
        <h1>Welcome back, @Model.StudentName! 👋</h1>
        <p class="page-subtitle">Here's what's happening with your learning</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="BrowseCourses"><i class="fa-solid fa-compass me-2"></i>Browse Courses</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon primary"><i class="fa-solid fa-book-open"></i></span>
            <div>
                <div class="stat-value">@Model.EnrolledCourses</div>
                <div class="stat-label">Enrolled Courses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon success"><i class="fa-solid fa-calendar-check"></i></span>
            <div>
                <div class="stat-value">@Model.AttendancePercentage%</div>
                <div class="stat-label">Attendance</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon warning"><i class="fa-solid fa-percent"></i></span>
            <div>
                <div class="stat-value">@(Model.AverageQuizScore > 0 ? $"{Model.AverageQuizScore}%" : "—")</div>
                <div class="stat-label">Avg. Quiz Score</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon info"><i class="fa-solid fa-award"></i></span>
            <div>
                <div class="stat-value">@(Model.AverageGpa?.ToString("0.00") ?? "—")</div>
                <div class="stat-label">Average GPA</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="card-title">My Courses</h6>
                <a class="btn btn-sm btn-outline-primary" asp-action="BrowseCourses"><i class="fa-solid fa-plus me-1"></i>Enroll in More</a>
            </div>
            @if (Model.Enrollments.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-compass"></i></div>
                    <h5>You're not enrolled in any courses yet</h5>
                    <p>Browse the course catalog and start learning today.</p>
                    <a class="btn btn-primary" asp-action="BrowseCourses"><i class="fa-solid fa-compass me-2"></i>Browse Courses</a>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var enrollment in Model.Enrollments)
                    {
                        <li class="list-group-item py-3" style="border-color:#f1f5f9">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="flex-grow-1" style="min-width:220px">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <a class="fw-semibold text-body" asp-action="CourseDetails" asp-route-id="@enrollment.CourseId">@enrollment.Course?.Title</a>
                                        @if (enrollment.IsCompleted)
                                        {
                                            <span class="badge badge-soft-success">Completed</span>
                                        }
                                    </div>
                                    <span class="text-muted" style="font-size:.82rem">
                                        <i class="fa-solid fa-chalkboard-user me-1"></i>@(enrollment.Course?.Faculty?.FullName ?? "Faculty")
                                        · <span class="badge badge-soft-muted">@enrollment.Course?.Category</span>
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2" style="width:180px">
                                    <div class="progress flex-grow-1"><div class="progress-bar @(enrollment.IsCompleted ? "bg-success" : "")" style="width:@(enrollment.ProgressPercentage)%"></div></div>
                                    <span class="text-muted" style="font-size:.8rem">@enrollment.ProgressPercentage%</span>
                                </div>
                                <a class="btn btn-sm btn-primary" asp-action="CourseDetails" asp-route-id="@enrollment.CourseId">Continue <i class="fa-solid fa-arrow-right ms-1"></i></a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="card-title">Recent Quiz Results</h6>
                <a class="btn btn-sm btn-outline-primary" asp-action="MyResults">View All</a>
            </div>
            @if (Model.RecentQuizResults.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No quiz attempts yet — open a course and take your first quiz!</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table app-table">
                        <thead><tr><th>Quiz</th><th>Course</th><th>Score</th><th>Result</th><th>Date</th></tr></thead>
                        <tbody>
                            @foreach (var result in Model.RecentQuizResults)
                            {
                                <tr>
                                    <td><a class="fw-medium text-body" asp-action="QuizResult" asp-route-quizResultId="@result.Id">@result.Quiz?.Title</a></td>
                                    <td class="text-muted">@result.Quiz?.Course?.Title</td>
                                    <td>@result.MarksObtained/@result.TotalMarks (@result.PercentageScore.ToString("0"))%</td>
                                    <td><span class="badge @(result.IsPassed ? "badge-soft-success" : "badge-soft-danger")">@(result.IsPassed ? "Passed" : "Failed")</span></td>
                                    <td class="text-muted">@result.AttemptedAt.ToString("dd MMM")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="card-title"><i class="fa-solid fa-bullhorn me-2 text-primary"></i>Announcements</h6>
                <a class="btn btn-sm btn-outline-primary" asp-action="Announcements">All</a>
            </div>
            @if (Model.Announcements.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No announcements right now.</p></div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var announcement in Model.Announcements)
                    {
                        <li class="list-group-item py-3" style="border-color:#f1f5f9">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-semibold" style="font-size:.9rem">@announcement.Title</span>
                                @if (announcement.Course != null)
                                {
                                    <span class="badge badge-soft-primary" style="font-size:.68rem">@announcement.Course.Title</span>
                                }
                            </div>
                            <p class="text-muted mb-1" style="font-size:.83rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden">@announcement.Content</p>
                            <span class="text-muted" style="font-size:.75rem">@announcement.CreatedAt.ToString("dd MMM yyyy")</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="card-title"><i class="fa-solid fa-calendar-check me-2 text-success"></i>Recent Attendance</h6>
                <a class="btn btn-sm btn-outline-primary" asp-action="MyAttendance">All</a>
            </div>
            @if (Model.RecentAttendance.Count == 0)
            {
                <div class="empty-state py-4"><p class="mb-0">No attendance records yet.</p></div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var record in Model.RecentAttendance)
                    {
                        var badge = record.Status switch
                        {
                            "Present" => "badge-soft-success",
                            "Absent" => "badge-soft-danger",
                            _ => "badge-soft-warning",
                        };
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2" style="border-color:#f1f5f9; font-size:.87rem">
                            <span class="text-muted">@record.AttendanceDate.ToString("ddd, dd MMM")</span>
                            <span class="badge @badge">@record.Status</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
