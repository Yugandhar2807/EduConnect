@model StudentProgressViewModel
@{
    ViewData["Title"] = "My Progress";
}

<div class="page-header">
    <div>
        <h1>My Progress</h1>
        <p class="page-subtitle">Attendance, course completion and academic results in one place</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon success"><i class="fa-solid fa-calendar-check"></i></span>
            <div>
                <div class="stat-value">@Model.AttendancePercentage%</div>
                <div class="stat-label">Attendance</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon primary"><i class="fa-solid fa-bars-progress"></i></span>
            <div>
                <div class="stat-value">@Model.AverageCourseProgress%</div>
                <div class="stat-label">Avg. Course Progress</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon warning"><i class="fa-solid fa-book-open"></i></span>
            <div>
                <div class="stat-value">@Model.ActiveCourses <small class="text-muted fw-normal" style="font-size:.85rem">active</small></div>
                <div class="stat-label">@Model.CompletedCourses completed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon info"><i class="fa-solid fa-award"></i></span>
            <div>
                <div class="stat-value">@Model.AverageGPA</div>
                <div class="stat-label">Average GPA (@Model.TotalSemesters semesters)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Monthly Attendance</h6></div>
            <div class="card-body">
                <div class="chart-container" style="height:250px"><canvas id="attendanceChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Attendance Split</h6></div>
            <div class="card-body">
                <div class="chart-container" style="height:250px"><canvas id="attendancePie"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h6 class="card-title">Course Progress</h6></div>
    @if (Model.CourseProgressDetails.Count == 0)
    {
        <div class="empty-state py-4"><p class="mb-0">No course activity yet — enroll in a course to start tracking progress.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr><th>Course</th><th>Completion</th><th>Topics</th><th>Quizzes Taken</th><th>Avg. Score</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var course in Model.CourseProgressDetails)
                    {
                        var statusBadge = course.ProgressStatus switch
                        {
                            "Completed" => "badge-soft-success",
                            "In Progress" => "badge-soft-info",
                            _ => "badge-soft-muted",
                        };
                        <tr>
                            <td class="fw-medium">@course.CourseName</td>
                            <td>
                                <div class="d-flex align-items-center gap-2" style="min-width:140px">
                                    <div class="progress flex-grow-1"><div class="progress-bar @(course.CompletionPercentage >= 100 ? "bg-success" : "")" style="width:@(course.CompletionPercentage)%"></div></div>
                                    <span style="font-size:.82rem">@course.CompletionPercentage%</span>
                                </div>
                            </td>
                            <td>@course.TopicsCompleted / @course.TotalTopics</td>
                            <td>@course.QuizzesTaken</td>
                            <td>@(course.QuizzesTaken > 0 ? $"{course.AverageScore}%" : "—")</td>
                            <td><span class="badge @statusBadge">@course.ProgressStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-header"><h6 class="card-title">Semester Results</h6></div>
    @if (Model.SemesterResultDetails.Count == 0)
    {
        <div class="empty-state py-4"><p class="mb-0">No semester results recorded yet.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr><th>Semester</th><th>Course</th><th>Marks</th><th>Grade</th><th>GPA</th></tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.SemesterResultDetails)
                    {
                        var gradeBadge = result.Grade switch
                        {
                            "A" => "badge-soft-success",
                            "B" => "badge-soft-primary",
                            "C" => "badge-soft-info",
                            "D" => "badge-soft-warning",
                            _ => "badge-soft-danger",
                        };
                        <tr>
                            <td class="text-muted">@result.Semester</td>
                            <td class="fw-medium">@result.CourseName</td>
                            <td>@result.MarksObtained.ToString("0.#")</td>
                            <td><span class="badge @gradeBadge">@result.Grade</span></td>
                            <td>@result.GPA.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#64748b';

        const breakdown = @Html.Raw(Json.Serialize(Model.AttendanceBreakdown));
        new Chart(document.getElementById('attendanceChart'), {
            type: 'bar',
            data: {
                labels: breakdown.map(b => b.month),
                datasets: [
                    { label: 'Present', data: breakdown.map(b => b.present), backgroundColor: '#16a34a', borderRadius: 4, maxBarThickness: 28 },
                    { label: 'Absent', data: breakdown.map(b => b.absent), backgroundColor: '#dc2626', borderRadius: 4, maxBarThickness: 28 },
                    { label: 'Leave', data: breakdown.map(b => b.leave), backgroundColor: '#d97706', borderRadius: 4, maxBarThickness: 28 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } },
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }
                }
            }
        });

        new Chart(document.getElementById('attendancePie'), {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent', 'Leave'],
                datasets: [{ data: [@Model.TotalPresent, @Model.TotalAbsent, @Model.TotalLeave], backgroundColor: ['#16a34a', '#dc2626', '#d97706'], borderWidth: 0 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '65%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } }
            }
        });
    </script>
}
