@model Quiz
@{
    ViewData["Title"] = Model.Title;
    var questions = Model.Questions?.ToList() ?? new List<QuizQuestion>();
    int previousAttempts = ViewBag.PreviousAttempts ?? 0;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@Model.CourseId">@Model.Course?.Title</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-subtitle">
            @questions.Count questions · @Model.TotalMarks marks · pass at @Model.PassingMarks%
            @if (previousAttempts > 0)
            {
                <span class="badge badge-soft-muted ms-1">Attempt #@(previousAttempts + 1)</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <div class="card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <i class="fa-solid fa-stopwatch text-primary"></i>
            <span class="quiz-timer" id="quizTimer">@(Model.DurationInMinutes):00</span>
        </div>
    </div>
</div>

<div class="card mb-3" style="position:sticky; top:calc(var(--topbar-height) + .5rem); z-index:1010">
    <div class="card-body py-2 d-flex align-items-center gap-3">
        <span class="text-muted" style="font-size:.87rem">Answered <span id="answeredCount">0</span> of @questions.Count</span>
        <div class="progress flex-grow-1"><div class="progress-bar" id="answerProgress" style="width:0%"></div></div>
        <button type="button" class="btn btn-primary btn-sm" id="submitQuizBtn"><i class="fa-solid fa-paper-plane me-2"></i>Submit Quiz</button>
    </div>
</div>

<form id="quizForm">
    @foreach (var (question, index) in questions.Select((q, i) => (q, i)))
    {
        <div class="card mb-3 question-card" data-question-id="@question.Id" data-question-type="@question.QuestionType">
            <div class="card-body">
                <div class="d-flex align-items-start gap-2 mb-3">
                    <span class="badge badge-soft-primary flex-shrink-0" style="font-size:.8rem">Q@(index + 1)</span>
                    <div class="flex-grow-1">
                        <p class="fw-medium mb-1" style="font-size:.97rem">@question.QuestionText</p>
                        <span class="text-muted" style="font-size:.78rem">
                            @question.Marks mark@(question.Marks == 1 ? "" : "s")
                            @if (!string.IsNullOrEmpty(question.Difficulty))
                            {
                                <span> · @question.Difficulty</span>
                            }
                        </span>
                    </div>
                </div>

                @if (question.QuestionType == "Coding")
                {
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge badge-soft-warning"><i class="fa-solid fa-code me-1"></i>@(question.ProgrammingLanguage ?? "python")</span>
                            <span class="text-muted" style="font-size:.8rem">Expected output: <code>@question.ExpectedOutput</code></span>
                        </div>
                        <textarea class="form-control code-editor code-input mb-2" rows="8" spellcheck="false">@question.CodeTemplate</textarea>
                        <div class="d-flex gap-2 align-items-center mb-2">
                            <button type="button" class="btn btn-sm btn-outline-primary run-code-btn" data-language="@(question.ProgrammingLanguage ?? "python")">
                                <i class="fa-solid fa-play me-1"></i>Run Code
                            </button>
                            <span class="run-status text-muted" style="font-size:.82rem"></span>
                        </div>
                        <div class="code-output" style="display:none"></div>
                    </div>
                }
                else if (question.QuestionType == "TrueFalse")
                {
                    <label class="quiz-option">
                        <input type="radio" name="q_@question.Id" value="True" />
                        <span>True</span>
                    </label>
                    <label class="quiz-option">
                        <input type="radio" name="q_@question.Id" value="False" />
                        <span>False</span>
                    </label>
                }
                else
                {
                    @foreach (var (optionText, letter) in new[] { (question.OptionA, "A"), (question.OptionB, "B"), (question.OptionC, "C"), (question.OptionD, "D") })
                    {
                        @if (!string.IsNullOrEmpty(optionText))
                        {
                            <label class="quiz-option">
                                <input type="radio" name="q_@question.Id" value="@letter" />
                                <span><strong class="me-1">@letter.</strong> @optionText</span>
                            </label>
                        }
                    }
                }
            </div>
        </div>
    }
</form>

<div class="d-flex justify-content-end mb-5">
    <button type="button" class="btn btn-primary btn-lg" id="submitQuizBtnBottom"><i class="fa-solid fa-paper-plane me-2"></i>Submit Quiz</button>
</div>

@section Scripts {
    <script>
        (function () {
            const totalQuestions = @questions.Count;
            const durationSeconds = @Model.DurationInMinutes * 60;
            const startTime = Date.now();
            let secondsLeft = durationSeconds;
            let submitted = false;
            const codingOutputs = {};   // questionId -> last run output

            /* ---------- Timer ---------- */
            const timerEl = document.getElementById('quizTimer');
            const timer = setInterval(function () {
                secondsLeft--;
                const m = Math.floor(secondsLeft / 60), s = secondsLeft % 60;
                timerEl.textContent = m + ':' + String(s).padStart(2, '0');
                if (secondsLeft <= 60) timerEl.classList.add('warning');
                if (secondsLeft <= 0) {
                    clearInterval(timer);
                    App.toast('Time is up — submitting your answers.', 'info');
                    submitQuiz(true);
                }
            }, 1000);

            /* ---------- Answer tracking ---------- */
            function answeredCount() {
                let count = 0;
                document.querySelectorAll('.question-card').forEach(function (card) {
                    const id = card.dataset.questionId;
                    if (card.dataset.questionType === 'Coding') {
                        if (codingOutputs[id] !== undefined) count++;
                    } else if (card.querySelector('input:checked')) {
                        count++;
                    }
                });
                return count;
            }

            function refreshProgress() {
                const count = answeredCount();
                document.getElementById('answeredCount').textContent = count;
                document.getElementById('answerProgress').style.width = (totalQuestions ? (count / totalQuestions * 100) : 0) + '%';
            }

            document.querySelectorAll('.quiz-option input').forEach(function (input) {
                input.addEventListener('change', function () {
                    input.closest('.card-body').querySelectorAll('.quiz-option').forEach(o => o.classList.remove('selected'));
                    input.closest('.quiz-option').classList.add('selected');
                    refreshProgress();
                });
            });

            /* ---------- Coding questions ---------- */
            document.querySelectorAll('.run-code-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const card = btn.closest('.question-card');
                    const code = card.querySelector('.code-input').value;
                    const outputEl = card.querySelector('.code-output');
                    const statusEl = card.querySelector('.run-status');
                    btn.disabled = true;
                    statusEl.textContent = 'Running…';
                    App.postJson('@Url.Action("ExecuteCode")', { code: code, language: btn.dataset.language })
                        .then(function (data) {
                            outputEl.style.display = '';
                            if (data.success) {
                                outputEl.textContent = data.output || '(no output)';
                                codingOutputs[card.dataset.questionId] = (data.output || '').trim();
                                statusEl.textContent = 'Output captured — it will be graded on submit.';
                            } else {
                                outputEl.textContent = data.error || 'Execution failed';
                                statusEl.textContent = 'Fix the error and run again.';
                            }
                            refreshProgress();
                        })
                        .catch(function () {
                            statusEl.textContent = 'Could not run the code — please try again.';
                        })
                        .finally(function () { btn.disabled = false; });
                });
            });

            /* ---------- Submit ---------- */
            function collectAnswers() {
                const answers = {};
                document.querySelectorAll('.question-card').forEach(function (card) {
                    const id = card.dataset.questionId;
                    if (card.dataset.questionType === 'Coding') {
                        if (codingOutputs[id] !== undefined) answers['question_' + id] = codingOutputs[id];
                    } else {
                        const checked = card.querySelector('input:checked');
                        if (checked) answers['question_' + id] = checked.value;
                    }
                });
                answers['_durationSeconds'] = String(Math.round((Date.now() - startTime) / 1000));
                return answers;
            }

            function submitQuiz(auto) {
                if (submitted) return;
                const unanswered = totalQuestions - answeredCount();
                const doSubmit = function () {
                    submitted = true;
                    clearInterval(timer);
                    document.querySelectorAll('#submitQuizBtn, #submitQuizBtnBottom').forEach(function (b) {
                        b.disabled = true;
                        b.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting…';
                    });
                    fetch('@Url.Action("SubmitQuiz")?quizId=@Model.Id', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': App.token() },
                        body: JSON.stringify(collectAnswers())
                    })
                    .then(r => r.json())
                    .then(function (data) {
                        if (data.success) {
                            App.toast('Quiz submitted — score ' + data.percentageScore + '%', data.isPassed ? 'success' : 'info');
                            window.location.href = data.redirectUrl;
                        } else {
                            throw new Error(data.error || 'Submission failed');
                        }
                    })
                    .catch(function (err) {
                        submitted = false;
                        App.toast(err.message || 'Submission failed — please try again.', 'error');
                        document.querySelectorAll('#submitQuizBtn, #submitQuizBtnBottom').forEach(function (b) {
                            b.disabled = false;
                            b.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i>Submit Quiz';
                        });
                    });
                };

                if (!auto && unanswered > 0) {
                    App.confirm('You have ' + unanswered + ' unanswered question' + (unanswered === 1 ? '' : 's') + '. Submit anyway?', doSubmit);
                } else {
                    doSubmit();
                }
            }

            document.getElementById('submitQuizBtn').addEventListener('click', function () { submitQuiz(false); });
            document.getElementById('submitQuizBtnBottom').addEventListener('click', function () { submitQuiz(false); });
            refreshProgress();
        })();
    </script>
}
