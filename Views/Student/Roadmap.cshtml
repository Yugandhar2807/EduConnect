@model IEnumerable<EduConnect.Models.RoadmapNode>

@{
    ViewData["Title"] = "Learning Roadmap";
}

<style>
    .roadmap-container {
        padding: 20px;
        min-height: 600px;
    }

    .roadmap-tree {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
        position: relative;
    }

    .tree-node {
        position: relative;
        margin: 20px;
        padding: 20px;
        min-width: 200px;
        max-width: 300px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .tree-node:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.5);
    }

    .tree-node.completed {
        background: rgba(40, 167, 69, 0.3);
        border-color: rgba(40, 167, 69, 0.6);
    }

    .tree-node.in-progress {
        background: rgba(255, 193, 7, 0.3);
        border-color: rgba(255, 193, 7, 0.6);
    }

    .node-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .node-title {
        font-weight: bold;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    .node-description {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 10px;
    }

    .node-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 10px;
    }

    .tree-level {
        display: flex;
        justify-content: center;
        gap: 40px;
        flex-wrap: wrap;
        margin: 30px 0;
        position: relative;
    }

    .tree-connector {
        position: absolute;
        width: 2px;
        background: rgba(255, 255, 255, 0.3);
        left: 50%;
        transform: translateX(-1px);
    }

    .horizontal-connector {
        position: absolute;
        height: 2px;
        background: rgba(255, 255, 255, 0.3);
        top: -20px;
    }

    .add-node-btn {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(0, 123, 255, 0.3);
        border: 2px dashed rgba(0, 123, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin: 20px;
    }

    .add-node-btn:hover {
        background: rgba(0, 123, 255, 0.5);
        transform: scale(1.1);
    }

    .roadmap-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .progress-summary {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin: 20px 0;
        flex-wrap: wrap;
    }

    .progress-card {
        padding: 15px 30px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        text-align: center;
    }

    .progress-number {
        font-size: 2rem;
        font-weight: bold;
        display: block;
    }

    .progress-label {
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    /* Modal styles */
    .modal-content {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 15px;
    }

    [data-theme="dark"] .modal-content {
        background: rgba(26, 26, 46, 0.95);
        color: var(--text-primary);
    }
</style>

<div class="roadmap-container">
    <div class="roadmap-header">
        <h1><i class="fas fa-route me-2"></i>My Learning Roadmap</h1>
        <p class="text-muted">Track your learning journey and set your goals</p>
    </div>

    <div class="progress-summary">
        <div class="progress-card">
            <span class="progress-number">@Model.Count(n => n.IsCompleted)</span>
            <span class="progress-label">Completed</span>
        </div>
        <div class="progress-card">
            <span class="progress-number">@Model.Count(n => !n.IsCompleted && n.StudentId != null)</span>
            <span class="progress-label">In Progress</span>
        </div>
        <div class="progress-card">
            <span class="progress-number">@Model.Count()</span>
            <span class="progress-label">Total Goals</span>
        </div>
    </div>

    <div class="text-center mb-4">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNodeModal">
            <i class="fas fa-plus me-2"></i>Add New Goal
        </button>
    </div>

    <div class="roadmap-tree">
        @{
            var rootNodes = Model.Where(n => n.ParentId == null).OrderBy(n => n.Order);
            
            void RenderNode(RoadmapNode node, int level)
            {
                var completedClass = node.IsCompleted ? "completed" : "";
                var iconColor = node.Color ?? "#007bff";
                var icon = node.Icon ?? "fa-circle";
                
                <div class="tree-node @completedClass" data-node-id="@node.Id" style="border-left: 4px solid @iconColor;">
                    <div class="node-icon" style="color: @iconColor;">
                        <i class="fas @icon"></i>
                    </div>
                    <div class="node-title">@node.Title</div>
                    @if (!string.IsNullOrEmpty(node.Description))
                    {
                        <div class="node-description">@node.Description</div>
                    }
                    @if (node.Course != null)
                    {
                        <div class="mb-2">
                            <span class="badge bg-info">
                                <i class="fas fa-book me-1"></i>@node.Course.Title
                            </span>
                        </div>
                    }
                    <div class="node-actions">
                        <button class="btn btn-sm @(node.IsCompleted ? "btn-success" : "btn-outline-success")" 
                                onclick="toggleCompletion(@node.Id)">
                            <i class="fas @(node.IsCompleted ? "fa-check-circle" : "fa-circle")"></i>
                        </button>
                        @if (node.StudentId != null)
                        {
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteNode(@node.Id)">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    </div>
                </div>
                
                var children = Model.Where(n => n.ParentId == node.Id).OrderBy(n => n.Order);
                if (children.Any())
                {
                    <div class="tree-level" style="margin-left: @((level * 40))px;">
                        @foreach (var child in children)
                        {
                            RenderNode(child, level + 1);
                        }
                    </div>
                }
            }
        }

        @if (rootNodes.Any())
        {
            <div class="tree-level">
                @foreach (var node in rootNodes)
                {
                    RenderNode(node, 0);
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted">
                <i class="fas fa-map fa-3x mb-3"></i>
                <p>No roadmap goals yet. Start by adding your first learning goal!</p>
            </div>
        }
    </div>
</div>

<!-- Add Node Modal -->
<div class="modal fade" id="addNodeModal" tabindex="-1" aria-labelledby="addNodeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNodeModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Add New Learning Goal
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addNodeForm">
                    <div class="mb-3">
                        <label for="nodeTitle" class="form-label">Goal Title *</label>
                        <input type="text" class="form-control" id="nodeTitle" required 
                               placeholder="e.g., Master JavaScript Basics">
                    </div>
                    <div class="mb-3">
                        <label for="nodeDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="nodeDescription" rows="3" 
                                  placeholder="Describe what you want to achieve..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nodeIcon" class="form-label">Icon</label>
                            <select class="form-select" id="nodeIcon">
                                <option value="fa-circle">Default Circle</option>
                                <option value="fa-book">Book</option>
                                <option value="fa-code">Code</option>
                                <option value="fa-graduation-cap">Graduation Cap</option>
                                <option value="fa-lightbulb">Lightbulb</option>
                                <option value="fa-rocket">Rocket</option>
                                <option value="fa-star">Star</option>
                                <option value="fa-trophy">Trophy</option>
                                <option value="fa-certificate">Certificate</option>
                                <option value="fa-laptop-code">Laptop Code</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="nodeColor" class="form-label">Color</label>
                            <input type="color" class="form-control" id="nodeColor" value="#007bff">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="nodeOrder" class="form-label">Order</label>
                        <input type="number" class="form-control" id="nodeOrder" value="0" min="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addNode()">
                    <i class="fas fa-plus me-2"></i>Add Goal
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleCompletion(nodeId) {
        fetch('@Url.Action("ToggleRoadmapNodeCompletion", "Student")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({ nodeId: nodeId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to update'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    }

    function deleteNode(nodeId) {
        if (!confirm('Are you sure you want to delete this goal?')) {
            return;
        }

        fetch('@Url.Action("DeleteRoadmapNode", "Student")?nodeId=' + nodeId, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to delete'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    }

    function addNode() {
        const title = document.getElementById('nodeTitle').value;
        const description = document.getElementById('nodeDescription').value;
        const icon = document.getElementById('nodeIcon').value;
        const color = document.getElementById('nodeColor').value;
        const order = parseInt(document.getElementById('nodeOrder').value) || 0;

        if (!title) {
            alert('Please enter a goal title');
            return;
        }

        const data = {
            title: title,
            description: description,
            icon: icon,
            color: color,
            order: order,
            parentId: null
        };

        fetch('@Url.Action("AddRoadmapNode", "Student")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: Failed to add goal');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred');
        });
    }
</script>
