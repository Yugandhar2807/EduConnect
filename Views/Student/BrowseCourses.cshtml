@model List<Course>
@{
    ViewData["Title"] = "Browse Courses";
    var enrolledIds = (HashSet<int>)ViewBag.EnrolledCourseIds;
    var categories = Model.Select(c => c.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().OrderBy(c => c).ToList();
}

<div class="page-header">
    <div>
        <h1>Course Catalog</h1>
        <p class="page-subtitle">@Model.Count course@(Model.Count == 1 ? "" : "s") available</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-3 d-flex gap-2 flex-wrap align-items-center">
        <div class="table-search flex-grow-1" style="max-width:320px">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" id="courseSearch" class="form-control form-control-sm" placeholder="Search courses…" />
        </div>
        <div class="d-flex gap-1 flex-wrap" id="categoryFilters">
            <button type="button" class="btn btn-sm btn-primary" data-category="">All</button>
            @foreach (var category in categories)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-category="@category">@category</button>
            }
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-compass"></i></div>
            <h5>No courses available yet</h5>
            <p>Check back soon — faculty are preparing new courses.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3" id="courseGrid">
        @foreach (var course in Model)
        {
            var isEnrolled = enrolledIds.Contains(course.Id);
            <div class="col-md-6 col-xl-4 course-card" data-category="@course.Category" data-search="@($"{course.Title} {course.Description} {course.Category} {course.Faculty?.FullName}".ToLowerInvariant())">
                <div class="card h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge badge-soft-muted">@course.Category</span>
                            @if (isEnrolled)
                            {
                                <span class="badge badge-soft-success"><i class="fa-solid fa-check me-1"></i>Enrolled</span>
                            }
                        </div>
                        <h6 class="mb-1">@course.Title</h6>
                        <p class="text-muted mb-3" style="font-size:.85rem; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden">@course.Description</p>
                        <div class="d-flex gap-3 text-muted mb-3 mt-auto" style="font-size:.82rem">
                            <span title="Instructor"><i class="fa-solid fa-chalkboard-user me-1"></i>@(course.Faculty?.FullName ?? "Faculty")</span>
                            <span title="Students"><i class="fa-solid fa-users me-1"></i>@(course.Enrollments?.Count ?? 0)</span>
                            <span title="Topics"><i class="fa-solid fa-list me-1"></i>@(course.Topics?.Count ?? 0)</span>
                            <span title="Quizzes"><i class="fa-solid fa-list-check me-1"></i>@(course.Quizzes?.Count ?? 0)</span>
                        </div>
                        @if (isEnrolled)
                        {
                            <a class="btn btn-outline-primary w-100" asp-action="CourseDetails" asp-route-id="@course.Id">
                                <i class="fa-solid fa-folder-open me-2"></i>Open Course
                            </a>
                        }
                        else
                        {
                            <form asp-action="EnrollCourse" method="post" data-confirm="Enroll in '@course.Title'?">
                                <input type="hidden" name="courseId" value="@course.Id" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fa-solid fa-circle-plus me-2"></i>Enroll Now
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card mt-3" id="noCourseResults" style="display:none">
        <div class="empty-state py-4">
            <h5>No courses match your search</h5>
            <p class="mb-0">Try a different keyword or category.</p>
        </div>
    </div>
}

@section Scripts {
    <script>
        const search = document.getElementById('courseSearch');
        const filterButtons = document.querySelectorAll('#categoryFilters button');
        let activeCategory = '';

        function applyFilters() {
            const query = (search.value || '').trim().toLowerCase();
            let visible = 0;
            document.querySelectorAll('.course-card').forEach(function (card) {
                const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
                const matchesSearch = !query || card.dataset.search.indexOf(query) !== -1;
                const show = matchesCategory && matchesSearch;
                card.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            const empty = document.getElementById('noCourseResults');
            if (empty) empty.style.display = visible === 0 ? '' : 'none';
        }

        if (search) search.addEventListener('input', applyFilters);
        filterButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                activeCategory = btn.dataset.category;
                filterButtons.forEach(b => { b.classList.remove('btn-primary'); b.classList.add('btn-outline-secondary'); });
                btn.classList.remove('btn-outline-secondary'); btn.classList.add('btn-primary');
                applyFilters();
            });
        });
    </script>
}
