<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · EduConnect" : "EduConnect")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-hero">
            <a class="d-inline-flex align-items-center gap-2 mb-4 text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px;background:rgba(255,255,255,.12);color:#fff;border-radius:10px"><i class="fa-solid fa-graduation-cap"></i></span>
                <span class="fw-bold fs-5 text-white">EduConnect</span>
            </a>
            <h1>The interactive learning portal for students &amp; faculty</h1>
            <p>Manage courses, share study materials, run quizzes, track attendance and monitor academic progress — all in one place.</p>
            <ul class="feature-list p-0 m-0">
                <li><i class="fa-solid fa-circle-check"></i> Role-based dashboards for admins, faculty and students</li>
                <li><i class="fa-solid fa-circle-check"></i> Interactive quizzes with instant scoring and analytics</li>
                <li><i class="fa-solid fa-circle-check"></i> Attendance, semester results and progress tracking</li>
            </ul>
        </div>
        <div class="auth-panel">
            <div class="auth-card">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
