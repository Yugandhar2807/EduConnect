@using System.Security.Principal
@using Microsoft.AspNetCore.Identity
@using EduConnect.Models
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (User?.Identity?.IsAuthenticated ?? false)
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrEmpty(currentUser?.FullName) ? currentUser.FullName : currentUser?.FirstName ?? User.Identity?.Name;
    <li class="nav-item">
        <span class="navbar-text me-3">Hello, @displayName!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
