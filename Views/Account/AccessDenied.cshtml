@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh">
    <div class="empty-state">
        <div class="empty-icon" style="width:80px;height:80px;font-size:2rem;background:var(--danger-soft);color:var(--danger)">
            <i class="fa-solid fa-lock"></i>
        </div>
        <h2 class="mb-2">Access denied</h2>
        <p>You do not have permission to view this page. If you believe this is a mistake, contact your administrator.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-house me-2"></i>Back to Home
        </a>
    </div>
</div>
