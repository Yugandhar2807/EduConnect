@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="card">
    <div class="card-body p-4">
        <h4 class="mb-1">Welcome back</h4>
        <p class="text-muted mb-4" style="font-size:.9rem">Sign in to your EduConnect account</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="username" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label" style="font-size:.88rem"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
            </button>
        </form>

        <p class="text-center text-muted mt-4 mb-0" style="font-size:.88rem">
            New student? <a asp-action="Register">Create an account</a>
        </p>
    </div>
</div>

<div class="card mt-3 demo-credentials">
    <div class="card-body py-3">
        <p class="fw-semibold mb-2"><i class="fa-solid fa-circle-info me-1 text-primary"></i>Demo accounts</p>
        <div class="row g-1 text-muted">
            <div class="col-4">Admin</div><div class="col-8"><code>admin@educonnect.com</code> / <code>Admin@123</code></div>
            <div class="col-4">Faculty</div><div class="col-8"><code>sarah.mitchell@educonnect.com</code> / <code>Faculty@123</code></div>
            <div class="col-4">Student</div><div class="col-8"><code>alex.johnson@student.educonnect.com</code> / <code>Student@123</code></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
