@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to EduConnect</h1>
    <p class="lead">An Interactive Learning Portal for Students and Faculty</p>
    
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="mt-4">
            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
        </div>
    }
    else
    {
        <p class="mt-4">Welcome! Select your role above to continue.</p>
    }
</div>
