@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5" style="max-width: 820px">
    <h1 class="mb-4">Privacy Policy</h1>
    <div class="card">
        <div class="card-body p-4">
            <p>EduConnect stores only the information needed to run the learning portal: account details (name, email, phone), course activity (enrollments, quiz attempts, progress), attendance records and academic results.</p>
            <h5 class="mt-4">How your data is used</h5>
            <ul class="text-muted">
                <li>Faculty can see the progress and results of students enrolled in their own courses.</li>
                <li>Administrators can manage accounts and academic records across the institution.</li>
                <li>Students see only their own records and course content they are enrolled in.</li>
            </ul>
            <h5 class="mt-4">Your choices</h5>
            <p class="text-muted mb-0">You can update your profile information at any time from the My Profile page. To request account deletion, contact your administrator.</p>
        </div>
    </div>
</div>
