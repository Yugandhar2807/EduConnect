@model IEnumerable<EduConnect.Models.RoadmapTemplate>

@{
    ViewData["Title"] = "Learning Roadmaps";
}

<style>
    .roadmap-library {
        padding: 2rem 0;
    }

    .roadmap-card {
        height: 100%;
        transition: all 0.3s ease;
        cursor: pointer;
        border-left: 4px solid;
    }

    .roadmap-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
    }

    .roadmap-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .roadmap-category {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .category-language {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .category-career {
        background: linear-gradient(135deg, #f093fb, #f5576c);
        color: white;
    }

    .category-framework {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: white;
    }

    .roadmap-stats {
        display: flex;
        justify-content: space-around;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    .stat-item {
        text-align: center;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent-primary);
    }

    .stat-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }
</style>

<div class="roadmap-library">
    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <h1><i class="fas fa-route me-2"></i>Learning Roadmaps</h1>
            <p class="lead text-muted">Choose your path and start your learning journey</p>
        </div>
    </div>

    @if (Model.Any())
    {
        var groupedRoadmaps = Model.GroupBy(r => r.Category);

        @foreach (var group in groupedRoadmaps)
        {
            <div class="mb-5">
                <h3 class="mb-4">
                    <i class="fas fa-folder-open me-2"></i>@group.Key
                </h3>
                <div class="row">
                    @foreach (var roadmap in group)
                    {
                        var categoryClass = roadmap.Category.ToLower() switch
                        {
                            "programming language" => "category-language",
                            "career path" => "category-career",
                            "framework" => "category-framework",
                            _ => "category-language"
                        };

                        var borderColor = roadmap.Color ?? "#667eea";

                        <div class="col-md-4 col-lg-3 mb-4">
                            <div class="card roadmap-card" style="border-left-color: @borderColor;" onclick="location.href='@Url.Action("View", "Roadmap", new { id = roadmap.Id })'">
                                <div class="card-body text-center">
                                    <div class="roadmap-icon" style="color: @borderColor;">
                                        <i class="fas @(roadmap.Icon ?? "fa-code")"></i>
                                    </div>
                                    <span class="roadmap-category @categoryClass">
                                        @roadmap.Level
                                    </span>
                                    <h5 class="card-title mt-2">@roadmap.Title</h5>
                                    <p class="card-text text-muted">@roadmap.Description</p>
                                    
                                    <div class="roadmap-stats">
                                        <div class="stat-item">
                                            <div class="stat-number">@roadmap.EstimatedHours</div>
                                            <div class="stat-label">Hours</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-number">@(roadmap.Topics?.Count ?? 0)</div>
                                            <div class="stat-label">Topics</div>
                                        </div>
                                    </div>

                                    <a href="@Url.Action("View", "Roadmap", new { id = roadmap.Id })" class="btn btn-primary btn-sm mt-3 w-100">
                                        <i class="fas fa-play me-2"></i>Start Learning
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
            <p class="lead text-muted">No roadmaps available yet.</p>
            <p class="text-muted">Check back soon for new learning paths!</p>
        </div>
    }
</div>
