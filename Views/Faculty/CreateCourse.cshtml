@model EduConnect.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1>Create New Course</h1>

        <form asp-action="CreateCourse" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Course Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category" class="form-control" placeholder="e.g., Programming, Mathematics, Science" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Course</button>
                <button type="button" class="btn btn-info" onclick="generateTopicsWithAI()">
                    <i class="fas fa-magic"></i> Generate Topics with AI
                </button>
                <a class="btn btn-secondary" asp-action="Dashboard">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function generateTopicsWithAI() {
            const title = document.querySelector('input[name="Title"]').value;
            const description = document.querySelector('textarea[name="Description"]').value;

            if (!title || !description) {
                alert('Please enter Course Title and Description first');
                return;
            }

            // Show loading message
            Swal.fire({
                title: 'Generating Topics...',
                html: 'Please wait while AI generates course topics<br><small>This may take 10-15 seconds</small>',
                allowOutsideClick: false,
                didOpen: async () => {
                    Swal.showLoading();
                    
                    try {
                        const response = await fetch('@Url.Action("GenerateTopicsAI", "Faculty")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                courseTitle: title,
                                courseDescription: description
                            })
                        });

                        const data = await response.json();
                        
                        if (data.success && data.topics && data.topics.length > 0) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Topics Generated!',
                                html: '<p>AI has generated the following topics:</p>' +
                                    '<ol style="text-align: left; margin-top: 10px;">' +
                                    data.topics.map(t => `<li>${t}</li>`).join('') +
                                    '</ol>' +
                                    '<p style="margin-top: 15px;"><strong>Topics will be saved after course creation!</strong></p>',
                                confirmButtonText: 'OK'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to generate topics. Please try again.'
                            });
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to generate topics: ' + error.message
                        });
                    }
                }
            });
        }
    </script>
}
