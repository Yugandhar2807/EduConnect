@model List<ApplicationUser>

@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fas fa-clipboard-list me-2"></i>Mark Attendance - @ViewBag.AttendanceDate.ToString("dddd, MMMM dd, yyyy")</h2>
            <p class="text-muted">Mark attendance for all students</p>
            <hr />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var student in Model)
                            {
                                var todayStatus = ViewBag.TodayAttendance?.ContainsKey(student.Id) == true 
                                    ? ViewBag.TodayAttendance[student.Id] 
                                    : "";
                                
                                <tr>
                                    <td>
                                        <strong style="color: #000; font-size: 16px; font-weight: 600;">@(student.FullName ?? student.UserName)</strong>
                                        <input type="hidden" name="studentIds" value="@student.Id" />
                                    </td>
                                    <td>
                                        <select name="status_@student.Id" class="form-select form-select-sm" style="width: 120px;">
                                            <option value="">-- Select --</option>
                                            @if (todayStatus == "Present")
                                            {
                                                <option value="Present" selected>Present</option>
                                            }
                                            else
                                            {
                                                <option value="Present">Present</option>
                                            }
                                            @if (todayStatus == "Absent")
                                            {
                                                <option value="Absent" selected>Absent</option>
                                            }
                                            else
                                            {
                                                <option value="Absent">Absent</option>
                                            }
                                            @if (todayStatus == "Leave")
                                            {
                                                <option value="Leave" selected>Leave</option>
                                            }
                                            else
                                            {
                                                <option value="Leave">Leave</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" name="remarks_@student.Id" class="form-control form-control-sm" placeholder="Optional notes" />
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox"></i> No students found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Attendance
                </button>
                <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </div>
    </form>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Attendance History</h5>
                </div>
                <div class="card-body">
                    <p><a href="@Url.Action("AttendanceList")" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-list me-1"></i>View All Records
                    </a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
    </div>
</div>
