@model Material

@{
    ViewData["Title"] = "Upload Study Material";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Upload Study Material</h2>
            <hr />
            
            <form asp-action="UploadMaterial" asp-route-courseId="@Model.CourseId" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Material Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., Chapter 1 Notes" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the material content"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FileType" class="form-label">File Type</label>
                    <select asp-for="FileType" class="form-control">
                        <option value="">-- Select File Type --</option>
                        <option value="PDF">PDF</option>
                        <option value="Video">Video</option>
                        <option value="Document">Document</option>
                        <option value="Image">Image</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="FileType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="file" class="form-label">Select File</label>
                    <input type="file" id="file" name="file" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.png,.mp4,.avi" />
                    <small class="form-text text-muted">Supported: PDF, Documents, Images, Videos</small>
                </div>

                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label">Course</label>
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <input type="text" class="form-control" disabled value="Course ID: @Model.CourseId" />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Upload Material</button>
                    <a asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
