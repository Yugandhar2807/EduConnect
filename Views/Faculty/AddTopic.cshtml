@model EduConnect.Models.Topic

@{
    ViewData["Title"] = "Add Topic";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h4 class="mb-0">➕ Add New Topic</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddTopic" asp-route-courseId="@Model.CourseId" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Topic Name</label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g., Python Strings" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of this topic" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="pdfFile" class="form-label fw-bold">📄 Upload PDF</label>
                            <input type="file" id="pdfFile" name="pdfFile" accept=".pdf" class="form-control" required>
                            <small class="form-text text-muted">Upload a PDF file for this topic (max size: 10MB)</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="fas fa-check-circle"></i> Add Topic
                            </button>
                            <a asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 10px;
    }
    
    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }
    
    .form-control, .form-control-lg {
        border: 1px solid #dee2e6;
        border-radius: 5px;
        transition: all 0.3s ease;
    }
    
    .form-control:focus, .form-control-lg:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
