@model TopicFormViewModel
@{
    ViewData["Title"] = "Add Topic";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@Model.CourseId">@ViewBag.CourseName</a></li>
                <li class="breadcrumb-item active">Add Topic</li>
            </ol>
        </nav>
        <h1>Add Topic</h1>
        <p class="page-subtitle">Add a topic to “@ViewBag.CourseName”</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="AddTopic" method="post" enctype="multipart/form-data" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="CourseId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Object-Oriented Programming" autofocus />
                        <span asp-validation-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="What does this topic cover?"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Topic PDF (optional)</label>
                        <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
                        @Html.ValidationMessage("pdfFile", new { @class = "field-validation-error" })
                        <div class="form-text">Attach lecture notes or a handout as PDF — up to 50&nbsp;MB.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Topic</button>
                        <a class="btn btn-outline-secondary" asp-action="CourseDetails" asp-route-id="@Model.CourseId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
