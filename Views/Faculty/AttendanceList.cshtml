@model IEnumerable<EduConnect.Models.Attendance>

@{
    ViewData["Title"] = "Attendance Records";
}

<div class="container mt-4">
    <h1 class="mb-3">
        <i class="fas fa-list me-2"></i>Attendance History
    </h1>

    <div class="mb-3">
        <a href="@Url.Action("ManageAttendance")" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Mark Attendance Today
        </a>
        <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Student Name</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var attendance in Model)
                        {
                            <tr>
                                <td>
                                    <strong style="color: #000; font-size: 16px; font-weight: 600;">@attendance.Student?.FullName</strong>
                                </td>
                                <td>@attendance.AttendanceDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (attendance.Status == "Present")
                                    {
                                        <span class="badge bg-success">Present</span>
                                    }
                                    else if (attendance.Status == "Absent")
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Leave</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(attendance.Remarks) ? "-" : attendance.Remarks)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-2"></i>No attendance records found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

