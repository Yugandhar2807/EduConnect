@model List<Attendance>
@{
    ViewData["Title"] = "Attendance Log";
    DateTime from = ViewBag.From;
    DateTime to = ViewBag.To;
    var presentCount = Model.Count(a => a.Status == "Present");
    var absentCount = Model.Count(a => a.Status == "Absent");
    var leaveCount = Model.Count(a => a.Status == "Leave");
}

<div class="page-header">
    <div>
        <h1>Attendance Log</h1>
        <p class="page-subtitle">@Model.Count record@(Model.Count == 1 ? "" : "s") between @from.ToString("dd MMM yyyy") and @to.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="ManageAttendance"><i class="fa-solid fa-clipboard-check me-2"></i>Mark Attendance</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="AttendanceList" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control form-control-sm" value="@from.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control form-control-sm" value="@to.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            </div>
            <div class="col-auto ms-auto d-flex gap-2">
                <span class="badge badge-soft-success align-self-center">@presentCount present</span>
                <span class="badge badge-soft-danger align-self-center">@absentCount absent</span>
                <span class="badge badge-soft-warning align-self-center">@leaveCount leave</span>
            </div>
        </form>
    </div>
</div>

<div class="card" data-table>
    <div class="card-header">
        <h6 class="card-title">Records</h6>
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search records…" data-table-search />
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
            <h5>No records in this range</h5>
            <p>Try widening the date range, or mark attendance for today.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table" data-page-size="15">
                <thead>
                    <tr>
                        <th data-sort="date">Date</th>
                        <th data-sort="text">Student</th>
                        <th data-sort="text">Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        var badge = record.Status switch
                        {
                            "Present" => "badge-soft-success",
                            "Absent" => "badge-soft-danger",
                            _ => "badge-soft-warning",
                        };
                        <tr>
                            <td class="text-muted" data-value="@record.AttendanceDate.ToString("yyyy-MM-dd")">@record.AttendanceDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-medium">@(record.Student?.FullName ?? record.Student?.Email)</td>
                            <td><span class="badge @badge">@record.Status</span></td>
                            <td class="text-muted">@(string.IsNullOrEmpty(record.Remarks) ? "—" : record.Remarks)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer table-pagination" data-table-pagination></div>
    }
</div>
