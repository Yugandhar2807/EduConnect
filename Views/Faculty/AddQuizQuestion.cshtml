@model QuizQuestion

@{
    ViewData["Title"] = "Add Quiz Question";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Add Question to Quiz</h2>
                <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#generateQuestionsModal">
                    🤖 Generate with AI
                </button>
            </div>
            <hr />
            
            <form asp-action="AddQuizQuestion" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Question Type Selection -->
                <div class="mb-3">
                    <label asp-for="QuestionType" class="form-label">Question Type</label>
                    <select asp-for="QuestionType" class="form-control" id="questionType" onchange="toggleQuestionType()">
                        <option value="MCQ">Multiple Choice</option>
                        <option value="TrueFalse">True/False</option>
                        <option value="Coding">Coding</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="QuestionText" class="form-label">Question</label>
                    <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Enter the question"></textarea>
                    <span asp-validation-for="QuestionText" class="text-danger"></span>
                </div>

                <!-- Multiple Choice Options -->
                <div id="multipleChoiceSection" class="card mb-3">
                    <div class="card-header">Answer Options</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="OptionA" class="form-label">Option A</label>
                            <input asp-for="OptionA" class="form-control" placeholder="Option A" />
                            <span asp-validation-for="OptionA" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OptionB" class="form-label">Option B</label>
                            <input asp-for="OptionB" class="form-control" placeholder="Option B" />
                            <span asp-validation-for="OptionB" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OptionC" class="form-label">Option C</label>
                            <input asp-for="OptionC" class="form-control" placeholder="Option C" />
                            <span asp-validation-for="OptionC" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OptionD" class="form-label">Option D</label>
                            <input asp-for="OptionD" class="form-control" placeholder="Option D" />
                            <span asp-validation-for="OptionD" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div id="correctAnswerSection" class="mb-3">
                    <label asp-for="CorrectOption" class="form-label">Correct Answer</label>
                    <select asp-for="CorrectOption" class="form-control" id="correctOptionSelect">
                        <option value="">-- Select Correct Option --</option>
                        <option value="A">Option A</option>
                        <option value="B">Option B</option>
                        <option value="C">Option C</option>
                        <option value="D">Option D</option>
                    </select>
                    <span asp-validation-for="CorrectOption" class="text-danger"></span>
                </div>

                <!-- Coding Question Fields -->
                <div id="codingSection" style="display: none;">
                    <div class="mb-3">
                        <label asp-for="ProgrammingLanguage" class="form-label">Programming Language</label>
                        <select asp-for="ProgrammingLanguage" class="form-control">
                            <option value="csharp">C#</option>
                            <option value="python">Python</option>
                            <option value="javascript">JavaScript</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CodeTemplate" class="form-label">Code Template (for students to complete)</label>
                        <textarea asp-for="CodeTemplate" class="form-control" rows="6" placeholder="Provide starting code template for students" style="font-family: monospace;"></textarea>
                        <small class="form-text text-muted">e.g., function sum(a, b) { // TODO: implement }</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExpectedOutput" class="form-label">Expected Output</label>
                        <textarea asp-for="ExpectedOutput" class="form-control" rows="3" placeholder="Expected program output when correct code is submitted" style="font-family: monospace;"></textarea>
                        <small class="form-text text-muted">e.g., 10 (if sum(5, 5) should output 10)</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Marks" class="form-label">Marks/Points</label>
                    <input asp-for="Marks" type="number" class="form-control" min="1" placeholder="e.g., 1" />
                    <span asp-validation-for="Marks" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="QuizId" type="hidden" />
                    <button type="submit" class="btn btn-primary">Add Question</button>
                    <a asp-action="CourseDetails" asp-route-id="@ViewBag.CourseId" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setCorrectOptions(options) {
        const select = document.getElementById('correctOptionSelect');
        select.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.text = '-- Select Correct Option --';
        select.appendChild(placeholder);
        options.forEach(opt => {
            const o = document.createElement('option');
            o.value = opt.value;
            o.text = opt.label;
            select.appendChild(o);
        });
    }

    function toggleQuestionType() {
        const typeSelect = document.getElementById('questionType');
        const mcSection = document.getElementById('multipleChoiceSection');
        const correctSection = document.getElementById('correctAnswerSection');
        const codingSection = document.getElementById('codingSection');
        
        const selectedType = typeSelect.value;
        
        if (selectedType === 'Coding') {
            mcSection.style.display = 'none';
            correctSection.style.display = 'none';
            codingSection.style.display = 'block';
        } else if (selectedType === 'TrueFalse') {
            mcSection.style.display = 'none';
            codingSection.style.display = 'none';
            correctSection.style.display = 'block';
            setCorrectOptions([
                { value: 'True', label: 'True' },
                { value: 'False', label: 'False' }
            ]);
        } else { // MCQ
            mcSection.style.display = 'block';
            correctSection.style.display = 'block';
            codingSection.style.display = 'none';
            setCorrectOptions([
                { value: 'A', label: 'Option A' },
                { value: 'B', label: 'Option B' },
                { value: 'C', label: 'Option C' },
                { value: 'D', label: 'Option D' }
            ]);
        }
    }
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', toggleQuestionType);
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function generateQuestionsFromPrompt() {
            console.log('Generate clicked');
            const mcCount = parseInt(document.getElementById('mcCount').value) || 0;
            const tfCount = parseInt(document.getElementById('tfCount').value) || 0;
            const codingCount = parseInt(document.getElementById('codingCount').value) || 0;
            const quizId = document.getElementById('quizIdHidden').value;

            if (mcCount === 0 && tfCount === 0 && codingCount === 0) {
                alert('Please enter at least one count');
                return;
            }

            console.log(`Sending: MCQ=${mcCount}, TF=${tfCount}, Coding=${codingCount}, QuizId=${quizId}`);
            
            fetch('/Faculty/GenerateQuestionsFromPrompt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quizId: parseInt(quizId), mcCount, tfCount, codingCount })
            })
            .then(r => r.json())
            .then(data => {
                console.log('Response:', data);
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(e => alert('Error: ' + e));
        }
    </script>
}

<!-- AI Question Generation Modal -->
<style>
    #generateQuestionsModal { z-index: 9999 !important; }
    #generateQuestionsModal .modal-backdrop { z-index: 9998 !important; }
</style>

<div class="modal fade" id="generateQuestionsModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">🤖 Generate Questions with AI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>How many questions of each type would you like to generate?</p>
                <input type="hidden" id="quizIdHidden" value="@ViewBag.QuizId" />
                
                <div class="mb-3">
                    <label for="mcCount" class="form-label fw-bold">Multiple Choice Questions</label>
                    <input type="number" class="form-control" id="mcCount" min="0" max="20" value="0" />
                </div>
                
                <div class="mb-3">
                    <label for="tfCount" class="form-label fw-bold">True/False Questions</label>
                    <input type="number" class="form-control" id="tfCount" min="0" max="20" value="0" />
                </div>
                
                <div class="mb-3">
                    <label for="codingCount" class="form-label fw-bold">Coding Questions</label>
                    <input type="number" class="form-control" id="codingCount" min="0" max="10" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-lg" onclick="generateQuestionsFromPrompt()">Generate</button>
            </div>
        </div>
    </div>
</div>
