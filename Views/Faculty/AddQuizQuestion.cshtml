@model QuestionFormViewModel
@{
    var quiz = (Quiz)ViewBag.Quiz;
    ViewData["Title"] = "Add Question";
    var existingCount = quiz.Questions?.Count ?? 0;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@quiz.CourseId">@quiz.Course?.Title</a></li>
                <li class="breadcrumb-item"><a asp-action="QuizDetails" asp-route-id="@quiz.Id">@quiz.Title</a></li>
                <li class="breadcrumb-item active">Add Question</li>
            </ol>
        </nav>
        <h1>Add Question</h1>
        <p class="page-subtitle">“@quiz.Title” currently has @existingCount question@(existingCount == 1 ? "" : "s") worth @quiz.TotalMarks marks</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="QuizDetails" asp-route-id="@quiz.Id"><i class="fa-solid fa-list me-2"></i>View Quiz</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="AddQuizQuestion" method="post" novalidate id="questionForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="QuizId" />

                    <div class="mb-3">
                        <label asp-for="QuestionType" class="form-label"></label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="QuestionType" id="typeMcq" value="MCQ" checked="@(Model.QuestionType != "TrueFalse" && Model.QuestionType != "Coding")" />
                            <label class="btn btn-outline-primary" for="typeMcq"><i class="fa-solid fa-list-ul me-1"></i>Multiple Choice</label>

                            <input type="radio" class="btn-check" name="QuestionType" id="typeTf" value="TrueFalse" checked="@(Model.QuestionType == "TrueFalse")" />
                            <label class="btn btn-outline-primary" for="typeTf"><i class="fa-solid fa-toggle-on me-1"></i>True / False</label>

                            <input type="radio" class="btn-check" name="QuestionType" id="typeCoding" value="Coding" checked="@(Model.QuestionType == "Coding")" />
                            <label class="btn btn-outline-primary" for="typeCoding"><i class="fa-solid fa-code me-1"></i>Coding</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="QuestionText" class="form-label"></label>
                        <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Type the question…"></textarea>
                        <span asp-validation-for="QuestionText"></span>
                    </div>

                    <!-- MCQ options -->
                    <div id="mcqFields">
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="OptionA" class="form-label">Option A</label>
                                <input asp-for="OptionA" class="form-control" />
                                <span asp-validation-for="OptionA"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="OptionB" class="form-label">Option B</label>
                                <input asp-for="OptionB" class="form-control" />
                                <span asp-validation-for="OptionB"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="OptionC" class="form-label">Option C</label>
                                <input asp-for="OptionC" class="form-control" />
                                <span asp-validation-for="OptionC"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="OptionD" class="form-label">Option D</label>
                                <input asp-for="OptionD" class="form-control" />
                                <span asp-validation-for="OptionD"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Coding fields -->
                    <div id="codingFields" style="display:none">
                        <div class="mb-3">
                            <label asp-for="ProgrammingLanguage" class="form-label"></label>
                            <select asp-for="ProgrammingLanguage" class="form-select" style="max-width:220px">
                                <option value="python">Python</option>
                                <option value="javascript">JavaScript</option>
                                <option value="csharp">C#</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CodeTemplate" class="form-label"></label>
                            <textarea asp-for="CodeTemplate" class="form-control code-editor" rows="6" placeholder="# Starter code shown to the student"></textarea>
                            <span asp-validation-for="CodeTemplate"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ExpectedOutput" class="form-label"></label>
                            <textarea asp-for="ExpectedOutput" class="form-control" rows="2" placeholder="Exact output expected from the program"></textarea>
                            <span asp-validation-for="ExpectedOutput"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-4" id="correctGroup">
                            <label asp-for="CorrectOption" class="form-label"></label>
                            <select asp-for="CorrectOption" class="form-select" id="correctSelect"></select>
                            <span asp-validation-for="CorrectOption"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Marks" class="form-label"></label>
                            <input asp-for="Marks" class="form-control" type="number" min="1" max="100" />
                            <span asp-validation-for="Marks"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Difficulty" class="form-label"></label>
                            <select asp-for="Difficulty" class="form-select">
                                <option>Easy</option>
                                <option>Medium</option>
                                <option>Hard</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" name="addAnother" value="true" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Save &amp; Add Another</button>
                        <button type="submit" name="addAnother" value="false" class="btn btn-outline-primary"><i class="fa-solid fa-check me-2"></i>Save &amp; Finish</button>
                        <a class="btn btn-outline-secondary" asp-action="QuizDetails" asp-route-id="@quiz.Id">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-xl-5">
        <div class="card" style="background:var(--primary-soft); border-color:#c7d2fe">
            <div class="card-body">
                <h6><i class="fa-solid fa-wand-magic-sparkles me-2 text-primary"></i>Generate questions with AI</h6>
                <p class="text-muted mb-3" style="font-size:.85rem">Let AI draft questions for this quiz based on its course and topic.</p>
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <label class="form-label" style="font-size:.8rem">MCQ</label>
                        <input type="number" id="aiMc" class="form-control form-control-sm" value="3" min="0" max="10" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" style="font-size:.8rem">True/False</label>
                        <input type="number" id="aiTf" class="form-control form-control-sm" value="2" min="0" max="10" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" style="font-size:.8rem">Coding</label>
                        <input type="number" id="aiCoding" class="form-control form-control-sm" value="0" min="0" max="5" />
                    </div>
                </div>
                <button type="button" id="aiGenerateBtn" class="btn btn-sm btn-primary w-100">
                    <i class="fa-solid fa-wand-magic-sparkles me-2"></i>Generate Questions
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const mcqFields = document.getElementById('mcqFields');
        const codingFields = document.getElementById('codingFields');
        const correctGroup = document.getElementById('correctGroup');
        const correctSelect = document.getElementById('correctSelect');

        function setCorrectOptions(options, selected) {
            correctSelect.innerHTML = '';
            options.forEach(function (opt) {
                const el = document.createElement('option');
                el.value = opt; el.textContent = opt;
                if (opt === selected) el.selected = true;
                correctSelect.appendChild(el);
            });
        }

        function syncType() {
            const type = document.querySelector('input[name="QuestionType"]:checked').value;
            mcqFields.style.display = type === 'MCQ' ? '' : 'none';
            codingFields.style.display = type === 'Coding' ? '' : 'none';
            correctGroup.style.display = type === 'Coding' ? 'none' : '';
            if (type === 'MCQ') setCorrectOptions(['A', 'B', 'C', 'D'], '@(Model.CorrectOption ?? "A")');
            else if (type === 'TrueFalse') setCorrectOptions(['True', 'False'], '@(Model.CorrectOption ?? "True")');
        }
        document.querySelectorAll('input[name="QuestionType"]').forEach(r => r.addEventListener('change', syncType));
        syncType();

        document.getElementById('aiGenerateBtn').addEventListener('click', function () {
            const btn = this;
            const body = {
                quizId: @quiz.Id,
                mcCount: parseInt(document.getElementById('aiMc').value) || 0,
                tfCount: parseInt(document.getElementById('aiTf').value) || 0,
                codingCount: parseInt(document.getElementById('aiCoding').value) || 0
            };
            if (body.mcCount + body.tfCount + body.codingCount === 0) {
                App.toast('Choose at least one question to generate.', 'info');
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generating…';
            App.postJson('@Url.Action("GenerateQuestionsFromPrompt")', body)
                .then(function (data) {
                    if (data.success) {
                        App.toast(data.message, 'success');
                        setTimeout(() => location.href = '@Url.Action("QuizDetails", new { id = quiz.Id })', 800);
                    } else {
                        App.toast(data.message || 'Generation failed', 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles me-2"></i>Generate Questions';
                    }
                })
                .catch(function () {
                    App.toast('Generation failed — please try again.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles me-2"></i>Generate Questions';
                });
        });
    </script>
}
