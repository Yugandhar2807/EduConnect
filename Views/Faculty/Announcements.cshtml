@model List<Announcement>
@{
    ViewData["Title"] = "Announcements";
}

<div class="page-header">
    <div>
        <h1>My Announcements</h1>
        <p class="page-subtitle">Publish updates to your courses or the whole portal</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateAnnouncement"><i class="fa-solid fa-plus me-2"></i>New Announcement</a>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-bullhorn"></i></div>
            <h5>No announcements yet</h5>
            <p>Keep your students informed — publish your first announcement.</p>
            <a class="btn btn-primary" asp-action="CreateAnnouncement"><i class="fa-solid fa-plus me-2"></i>New Announcement</a>
        </div>
    }
    else
    {
        @foreach (var announcement in Model)
        {
            <div class="announcement-item">
                <span class="announcement-icon"><i class="fa-solid fa-bullhorn"></i></span>
                <div class="flex-grow-1" style="min-width:0">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold">@announcement.Title</span>
                        @if (announcement.Course != null)
                        {
                            <span class="badge badge-soft-primary">@announcement.Course.Title</span>
                        }
                        else
                        {
                            <span class="badge badge-soft-info">Global</span>
                        }
                        <span class="badge @(announcement.IsActive ? "badge-soft-success" : "badge-soft-muted")">@(announcement.IsActive ? "Visible" : "Hidden")</span>
                    </div>
                    <p class="text-muted mb-1 mt-1" style="font-size:.88rem; white-space:pre-wrap">@announcement.Content</p>
                    <span class="text-muted" style="font-size:.78rem"><i class="fa-solid fa-clock me-1"></i>@announcement.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                <div class="d-flex flex-column gap-2 flex-shrink-0">
                    <form asp-action="ToggleAnnouncement" asp-route-id="@announcement.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100" title="@(announcement.IsActive ? "Hide" : "Show")">
                            <i class="fa-solid @(announcement.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </form>
                    <form asp-action="DeleteAnnouncement" asp-route-id="@announcement.Id" method="post" data-confirm="Delete announcement '@announcement.Title'?">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </form>
                </div>
            </div>
        }
    }
</div>
