@model FacultyDashboardViewModel
@{
    ViewData["Title"] = "Faculty Dashboard";
}

<div class="page-header">
    <div>
        <h1>My Teaching Dashboard</h1>
        <p class="page-subtitle">Your courses, students and recent activity</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-primary" asp-action="CreateAnnouncement"><i class="fa-solid fa-bullhorn me-2"></i>New Announcement</a>
        <a class="btn btn-primary" asp-action="CreateCourse"><i class="fa-solid fa-plus me-2"></i>Create Course</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon primary"><i class="fa-solid fa-book-open"></i></span>
            <div>
                <div class="stat-value">@Model.TotalCourses</div>
                <div class="stat-label">My Courses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon success"><i class="fa-solid fa-user-graduate"></i></span>
            <div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Enrolled Students</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon warning"><i class="fa-solid fa-list-check"></i></span>
            <div>
                <div class="stat-value">@Model.TotalQuizzes</div>
                <div class="stat-label">Quizzes</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon info"><i class="fa-solid fa-bullhorn"></i></span>
            <div>
                <div class="stat-value">@Model.TotalAnnouncements</div>
                <div class="stat-label">Announcements</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Courses.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-book"></i></div>
            <h5>No courses yet</h5>
            <p>Create your first course, add topics and materials, then publish quizzes for your students.</p>
            <a class="btn btn-primary" asp-action="CreateCourse"><i class="fa-solid fa-plus me-2"></i>Create Your First Course</a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header"><h6 class="card-title">Enrollments per Course</h6></div>
                <div class="card-body">
                    <div class="chart-container" style="height: 260px"><canvas id="enrollmentChart"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="card-title">Recent Quiz Attempts</h6>
                </div>
                <div class="card-body p-0" style="max-height: 320px; overflow-y: auto">
                    @if (Model.RecentQuizAttempts.Count == 0)
                    {
                        <div class="empty-state py-4">
                            <p class="mb-0">No quiz attempts yet.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var attempt in Model.RecentQuizAttempts)
                            {
                                <li class="list-group-item d-flex align-items-center gap-3 py-2" style="border-color:#f1f5f9">
                                    <span class="badge @(attempt.Success == true ? "badge-soft-success" : "badge-soft-danger")" style="min-width:52px">@attempt.Detail</span>
                                    <div class="flex-grow-1" style="min-width:0">
                                        <div class="fw-medium text-truncate" style="font-size:.88rem">@attempt.StudentName</div>
                                        <div class="text-muted text-truncate" style="font-size:.8rem">@attempt.Target</div>
                                    </div>
                                    <span class="text-muted flex-shrink-0" style="font-size:.78rem">@attempt.OccurredAt.ToString("dd MMM")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-3">My Courses</h5>
    <div class="row g-3">
        @foreach (var item in Model.Courses)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge badge-soft-muted">@item.Course.Category</span>
                            <span class="badge @(item.Course.IsActive ? "badge-soft-success" : "badge-soft-danger")">@(item.Course.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <h6 class="mb-1">
                            <a asp-action="CourseDetails" asp-route-id="@item.Course.Id" class="text-body">@item.Course.Title</a>
                        </h6>
                        <p class="text-muted mb-3" style="font-size:.85rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden">@item.Course.Description</p>

                        <div class="d-flex gap-3 text-muted mb-3 mt-auto" style="font-size:.82rem">
                            <span title="Students"><i class="fa-solid fa-user-graduate me-1"></i>@item.EnrollmentCount</span>
                            <span title="Topics"><i class="fa-solid fa-list me-1"></i>@item.TopicCount</span>
                            <span title="Materials"><i class="fa-solid fa-file-lines me-1"></i>@item.MaterialCount</span>
                            <span title="Quizzes"><i class="fa-solid fa-list-check me-1"></i>@item.QuizCount</span>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="progress flex-grow-1"><div class="progress-bar" style="width:@(item.AverageProgress)%"></div></div>
                            <span class="text-muted" style="font-size:.8rem">@item.AverageProgress% avg</span>
                        </div>

                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary flex-grow-1" asp-action="CourseDetails" asp-route-id="@item.Course.Id"><i class="fa-solid fa-folder-open me-1"></i>Manage</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="CourseStudents" asp-route-id="@item.Course.Id" title="Students"><i class="fa-solid fa-users"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditCourse" asp-route-id="@item.Course.Id" title="Edit"><i class="fa-solid fa-pen"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const chartEl = document.getElementById('enrollmentChart');
        if (chartEl) {
            Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
            Chart.defaults.color = '#64748b';
            const data = @Html.Raw(Json.Serialize(Model.EnrollmentsPerCourse));
            new Chart(chartEl, {
                type: 'bar',
                data: {
                    labels: data.map(p => p.label),
                    datasets: [{ data: data.map(p => p.value), backgroundColor: '#4f46e5', borderRadius: 6, maxBarThickness: 30 }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }, y: { grid: { display: false } } }
                }
            });
        }
    </script>
}
