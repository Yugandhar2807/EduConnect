@model QuizFormViewModel
@{
    ViewData["Title"] = "Create Quiz";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="CourseDetails" asp-route-id="@Model.CourseId">@ViewBag.CourseTitle</a></li>
                <li class="breadcrumb-item active">Create Quiz</li>
            </ol>
        </nav>
        <h1>Create Quiz</h1>
        <p class="page-subtitle">New quiz for “@ViewBag.CourseTitle” — you'll add questions in the next step</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="CreateQuiz" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="CourseId" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Quiz Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Fundamentals Check" autofocus />
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description (optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="What does this quiz assess?"></textarea>
                        <span asp-validation-for="Description"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="PassingMarks" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="PassingMarks" class="form-control" type="number" min="1" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="PassingMarks"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DurationInMinutes" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="DurationInMinutes" class="form-control" type="number" min="1" max="300" />
                                <span class="input-group-text">min</span>
                            </div>
                            <span asp-validation-for="DurationInMinutes"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-arrow-right me-2"></i>Create &amp; Add Questions</button>
                        <a class="btn btn-outline-secondary" asp-action="CourseDetails" asp-route-id="@Model.CourseId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
