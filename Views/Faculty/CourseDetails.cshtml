@model Course
@{
    ViewData["Title"] = Model.Title;
    var topics = Model.Topics?.OrderBy(t => t.CreatedAt).ToList() ?? new List<Topic>();
    var materials = Model.Materials?.OrderByDescending(m => m.UploadedAt).ToList() ?? new List<Material>();
    var quizzes = Model.Quizzes?.OrderByDescending(q => q.CreatedAt).ToList() ?? new List<Quiz>();
    var enrollmentCount = Model.Enrollments?.Count ?? 0;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p class="page-subtitle">
            <span class="badge badge-soft-muted me-1">@Model.Category</span>
            <span class="badge @(Model.IsActive ? "badge-soft-success" : "badge-soft-danger") me-2">@(Model.IsActive ? "Active" : "Inactive")</span>
            @enrollmentCount student@(enrollmentCount == 1 ? "" : "s") enrolled
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-primary" asp-action="CourseStudents" asp-route-id="@Model.Id"><i class="fa-solid fa-users me-2"></i>Students</a>
        <a class="btn btn-outline-secondary" asp-action="EditCourse" asp-route-id="@Model.Id"><i class="fa-solid fa-pen me-2"></i>Edit</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <p class="text-muted mb-0">@Model.Description</p>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="courseTabs" role="tablist" style="border-bottom-color:var(--border)">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-topics" type="button" role="tab"><i class="fa-solid fa-list me-2"></i>Topics <span class="badge badge-soft-muted ms-1">@topics.Count</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-materials" type="button" role="tab"><i class="fa-solid fa-file-lines me-2"></i>Materials <span class="badge badge-soft-muted ms-1">@materials.Count</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-quizzes" type="button" role="tab"><i class="fa-solid fa-list-check me-2"></i>Quizzes <span class="badge badge-soft-muted ms-1">@quizzes.Count</span></button></li>
</ul>

<div class="tab-content">
    <!-- ==================== TOPICS ==================== -->
    <div class="tab-pane fade show active" id="tab-topics" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title">Course Topics</h6>
                <div class="d-flex gap-2">
                    <form asp-action="GenerateTopicsWithAI" method="post" data-confirm="Generate a topic syllabus for this course with AI?">
                        <input type="hidden" name="courseId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Generate with AI</button>
                    </form>
                    <a class="btn btn-sm btn-primary" asp-action="AddTopic" asp-route-courseId="@Model.Id"><i class="fa-solid fa-plus me-1"></i>Add Topic</a>
                </div>
            </div>
            @if (topics.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-list"></i></div>
                    <h5>No topics yet</h5>
                    <p>Structure your course with topics — add them manually or generate a full syllabus with AI.</p>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var (topic, index) in topics.Select((t, i) => (t, i)))
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 py-3" style="border-color:#f1f5f9">
                            <span class="avatar" style="width:32px;height:32px;font-size:.8rem">@(index + 1)</span>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="fw-medium">@topic.Name</div>
                                <div class="text-muted text-truncate" style="font-size:.83rem">@topic.Description</div>
                            </div>
                            @if (!string.IsNullOrEmpty(topic.PdfFilePath))
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@topic.PdfFilePath" target="_blank" title="View PDF"><i class="fa-solid fa-file-pdf"></i></a>
                            }
                            <form asp-action="GenerateMaterialWithAI" method="post" class="d-inline">
                                <input type="hidden" name="topicId" value="@topic.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Generate learning material with AI"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
                            </form>
                            <form asp-action="DeleteTopic" method="post" class="d-inline" data-confirm="Delete topic '@topic.Name'?">
                                <input type="hidden" name="topicId" value="@topic.Id" />
                                <input type="hidden" name="courseId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- ==================== MATERIALS ==================== -->
    <div class="tab-pane fade" id="tab-materials" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title">Study Materials</h6>
                <a class="btn btn-sm btn-primary" asp-action="UploadMaterial" asp-route-courseId="@Model.Id"><i class="fa-solid fa-upload me-1"></i>Add Material</a>
            </div>
            @if (materials.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-file-lines"></i></div>
                    <h5>No materials yet</h5>
                    <p>Upload PDFs, videos or documents — or write text notes directly.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table app-table">
                        <thead>
                            <tr><th>Title</th><th>Type</th><th>Size</th><th>Uploaded</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var material in materials)
                            {
                                var icon = material.FileType switch
                                {
                                    "PDF" => "fa-file-pdf text-danger",
                                    "Video" => "fa-file-video text-primary",
                                    "Image" => "fa-file-image text-success",
                                    "Text" => "fa-file-pen text-info",
                                    _ => "fa-file text-secondary",
                                };
                                <tr>
                                    <td>
                                        <i class="fa-solid @icon me-2"></i><span class="fw-medium">@material.Title</span>
                                    </td>
                                    <td><span class="badge badge-soft-muted">@material.FileType</span></td>
                                    <td class="text-muted">@(material.FileSize > 0 ? $"{material.FileSize / 1024.0 / 1024.0:0.##} MB" : "—")</td>
                                    <td class="text-muted">@material.UploadedAt.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (!string.IsNullOrEmpty(material.FilePath))
                                            {
                                                <a class="btn btn-outline-secondary" href="@material.FilePath" target="_blank" title="Open"><i class="fa-solid fa-up-right-from-square"></i></a>
                                            }
                                            else if (material.FileType == "Text")
                                            {
                                                <button type="button" class="btn btn-outline-secondary" title="Read"
                                                        data-bs-toggle="modal" data-bs-target="#materialModal"
                                                        data-title="@material.Title" data-content="@material.Description">
                                                    <i class="fa-solid fa-book-open"></i>
                                                </button>
                                            }
                                            <form asp-action="DeleteMaterial" method="post" class="d-inline" data-confirm="Delete material '@material.Title'?">
                                                <input type="hidden" name="materialId" value="@material.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ==================== QUIZZES ==================== -->
    <div class="tab-pane fade" id="tab-quizzes" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h6 class="card-title">Quizzes</h6>
                <a class="btn btn-sm btn-primary" asp-action="CreateQuiz" asp-route-courseId="@Model.Id"><i class="fa-solid fa-plus me-1"></i>Create Quiz</a>
            </div>
            @if (quizzes.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="fa-solid fa-list-check"></i></div>
                    <h5>No quizzes yet</h5>
                    <p>Create a quiz and add multiple-choice, true/false or coding questions.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table app-table">
                        <thead>
                            <tr><th>Quiz</th><th>Questions</th><th>Total Marks</th><th>Pass %</th><th>Duration</th><th>Status</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var quiz in quizzes)
                            {
                                <tr>
                                    <td>
                                        <a class="fw-medium text-body" asp-action="QuizDetails" asp-route-id="@quiz.Id">@quiz.Title</a>
                                    </td>
                                    <td>@(quiz.Questions?.Count ?? 0)</td>
                                    <td>@quiz.TotalMarks</td>
                                    <td>@quiz.PassingMarks%</td>
                                    <td class="text-muted">@quiz.DurationInMinutes min</td>
                                    <td><span class="badge @(quiz.IsActive ? "badge-soft-success" : "badge-soft-muted")">@(quiz.IsActive ? "Visible" : "Hidden")</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-secondary" asp-action="QuizDetails" asp-route-id="@quiz.Id" title="Manage"><i class="fa-solid fa-folder-open"></i></a>
                                            <a class="btn btn-outline-secondary" asp-action="AddQuizQuestion" asp-route-quizId="@quiz.Id" title="Add Question"><i class="fa-solid fa-plus"></i></a>
                                            <form asp-action="DeleteQuiz" method="post" class="d-inline" data-confirm="Delete quiz '@quiz.Title' and all its questions and results?">
                                                <input type="hidden" name="quizId" value="@quiz.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Text material reader modal -->
<div class="modal fade" id="materialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="materialModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="materialModalBody" style="white-space:pre-wrap; font-size:.93rem"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const materialModal = document.getElementById('materialModal');
        materialModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            materialModal.querySelector('#materialModalTitle').textContent = btn.dataset.title;
            materialModal.querySelector('#materialModalBody').textContent = btn.dataset.content;
        });
    </script>
}
