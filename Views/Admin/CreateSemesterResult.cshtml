@model SemesterResult
@{
    ViewData["Title"] = "Add Semester Result";
    var students = (IList<ApplicationUser>)ViewBag.Students;
    var semesters = (string[])ViewBag.Semesters;
    var grades = (string[])ViewBag.Grades;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="SemesterResultsList">Semester Results</a></li>
                <li class="breadcrumb-item active">Add Result</li>
            </ol>
        </nav>
        <h1>Add Semester Result</h1>
        <p class="page-subtitle">Record an official course grade for a student</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="CreateSemesterResult" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="StudentId" class="form-label">Student</label>
                        <select asp-for="StudentId" class="form-select">
                            <option value="">Select a student…</option>
                            @foreach (var s in students.OrderBy(s => s.FullName))
                            {
                                <option value="@s.Id">@(s.FullName ?? s.Email)</option>
                            }
                        </select>
                        <span asp-validation-for="StudentId"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Semester" class="form-label"></label>
                            <select asp-for="Semester" class="form-select">
                                <option value="">Select semester…</option>
                                @foreach (var sem in semesters)
                                {
                                    <option value="@sem">@sem</option>
                                }
                            </select>
                            <span asp-validation-for="Semester"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="CourseName" class="form-label">Course Name</label>
                            <input asp-for="CourseName" class="form-control" placeholder="e.g. Data Structures" />
                            <span asp-validation-for="CourseName"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label asp-for="MarksObtained" class="form-label">Marks (0–100)</label>
                            <input asp-for="MarksObtained" class="form-control" type="number" step="0.1" min="0" max="100" />
                            <span asp-validation-for="MarksObtained"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Grade" class="form-label"></label>
                            <select asp-for="Grade" class="form-select">
                                <option value="">Grade…</option>
                                @foreach (var g in grades)
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                            <span asp-validation-for="Grade"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="GPA" class="form-label">GPA (0–4)</label>
                            <input asp-for="GPA" class="form-control" type="number" step="0.1" min="0" max="4" />
                            <span asp-validation-for="GPA"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label">Remarks (optional)</label>
                        <input asp-for="Remarks" class="form-control" placeholder="e.g. Excellent performance" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save Result</button>
                        <a class="btn btn-outline-secondary" asp-action="SemesterResultsList">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
