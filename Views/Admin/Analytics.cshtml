@{
    ViewData["Title"] = "Analytics Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<style>
    .analytics-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px 20px;
        margin-bottom: 40px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .analytics-header h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .metric-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        margin-bottom: 20px;
        border-top: 4px solid;
        transition: all 0.3s ease;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .metric-card.primary { border-top-color: #667eea; }
    .metric-card.success { border-top-color: #43e97b; }
    .metric-card.info { border-top-color: #4facfe; }
    .metric-card.warning { border-top-color: #f5576c; }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
        color: #2d3748;
        margin: 10px 0;
    }

    .metric-label {
        font-size: 0.9rem;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 500;
    }

    .chart-container {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        margin-bottom: 30px;
    }

    .chart-container h3 {
        color: #2d3748;
        margin-top: 0;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.3rem;
    }

    .chart-container h3 i {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-bottom: 30px;
    }

    .table-container h3 {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px 25px;
        margin: 0;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-container table {
        width: 100%;
        margin: 0;
    }

    .table-container thead {
        background: #f7fafc;
        border-bottom: 2px solid #e2e8f0;
    }

    .table-container th {
        padding: 15px 20px;
        color: #4a5568;
        font-weight: 600;
        text-align: left;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-container td {
        padding: 15px 20px;
        border-bottom: 1px solid #e2e8f0;
        color: #4a5568;
    }

    .table-container tbody tr:hover {
        background: #f7fafc;
    }

    .badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-primary { background: #e6fffa; color: #276749; }
    .badge-success { background: #c6f6d5; color: #22543d; }
    .badge-warning { background: #feebc8; color: #7c2d12; }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .progress-bar {
        background: #e2e8f0;
        height: 6px;
        border-radius: 10px;
        overflow: hidden;
        margin: 8px 0;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
    }
</style>
</style>

<div class="analytics-header">
    <h1>
        <i class="fas fa-chart-bar"></i>
        Analytics Dashboard
    </h1>
</div>

<div class="container-fluid">
    <!-- Key Metrics Row -->
    <div class="stats-grid">
        <div class="metric-card primary">
            <div class="metric-label">Total Students</div>
            <div class="metric-value">@Model.TotalStudents</div>
        </div>
        <div class="metric-card success">
            <div class="metric-label">Total Faculty</div>
            <div class="metric-value">@Model.TotalFaculty</div>
        </div>
        <div class="metric-card info">
            <div class="metric-label">Active Courses</div>
            <div class="metric-value">@Model.TotalCourses</div>
        </div>
        <div class="metric-card warning">
            <div class="metric-label">Total Enrollments</div>
            <div class="metric-value">@Model.TotalEnrollments</div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-lg-6">
            <div class="chart-container">
                <h3>
                    <i class="fas fa-pie-chart"></i>
                    Students vs Faculty Distribution
                </h3>
                <canvas id="distributionChart"></canvas>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-container">
                <h3>
                    <i class="fas fa-bar-chart"></i>
                    Platform Overview
                </h3>
                <canvas id="overviewChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Course Statistics Table -->
    @if (Model.CourseStats != null && Model.CourseStats.Count > 0)
    {
        <div class="table-container">
            <h3>
                <i class="fas fa-book"></i>
                Course Enrollment & Performance
            </h3>
            <table>
                <thead>
                    <tr>
                        <th>Course Title</th>
                        <th>Faculty</th>
                        <th>Enrollments</th>
                        <th>Average Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var sortedCourses = ((System.Collections.IEnumerable)Model.CourseStats).Cast<dynamic>().OrderByDescending(c => c.EnrollmentCount);
                    }
                    @foreach (var course in sortedCourses)
                    {
                        <tr>
                            <td style="font-weight: 500;">@course.Title</td>
                            <td>@course.FacultyName</td>
                            <td>
                                <span class="badge badge-primary">
                                    @course.EnrollmentCount Students
                                </span>
                            </td>
                            <td>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @course.AverageProgress%"></div>
                                </div>
                                <small style="color: #718096;">@Math.Round(course.AverageProgress, 1)%</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Faculty Course Distribution -->
    @if (Model.FacultyStats != null && Model.FacultyStats.Count > 0)
    {
        <div class="table-container">
            <h3>
                <i class="fas fa-chalkboard-user"></i>
                Faculty Course Distribution
            </h3>
            <table>
                <thead>
                    <tr>
                        <th>Faculty Name</th>
                        <th>Courses Created</th>
                        <th>Total Students</th>
                        <th>Courses</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var sortedFaculty = ((System.Collections.IEnumerable)Model.FacultyStats).Cast<dynamic>().OrderByDescending(f => f.CourseCount);
                    }
                    @foreach (var faculty in sortedFaculty)
                    {
                        <tr>
                            <td style="font-weight: 500;">@faculty.FacultyName</td>
                            <td>
                                <span class="badge badge-success">
                                    @faculty.CourseCount Courses
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-info">
                                    @faculty.StudentCount Students
                                </span>
                            </td>
                            <td>
                                @{
                                    var courseList = ((System.Collections.Generic.List<string>)faculty.Courses);
                                    var displayCourses = courseList.Take(2);
                                }
                                <small>@string.Join(", ", displayCourses)</small>
                                @if (courseList.Count > 2)
                                {
                                    <small> +@(courseList.Count - 2) more</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Top Performing Courses -->
    @if (Model.TopPerformingCourses != null && Model.TopPerformingCourses.Count > 0)
    {
        <div class="chart-container">
            <h3>
                <i class="fas fa-star"></i>
                Top Performing Courses
            </h3>
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th>Rank</th>
                        <th>Course</th>
                        <th>Average Progress</th>
                        <th>Enrollments</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.TopPerformingCourses.Count; i++)
                    {
                        var course = Model.TopPerformingCourses[i];
                        <tr>
                            <td><strong>#@(i + 1)</strong></td>
                            <td>@course.Title</td>
                            <td>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: @course.AverageProgress%"></div>
                                </div>
                                @Math.Round(course.AverageProgress, 1)%
                            </td>
                            <td>@course.EnrollmentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Back Button -->
    <div style="margin-top: 40px; margin-bottom: 40px;">
        <a href="@Url.Action("Dashboard")" class="btn btn-outline-primary" style="border-radius: 10px; padding: 10px 30px;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<script>
    // Distribution Chart
    const distributionCtx = document.getElementById('distributionChart').getContext('2d');
    new Chart(distributionCtx, {
        type: 'doughnut',
        data: {
            labels: ['Students', 'Faculty'],
            datasets: [{
                data: [@Model.TotalStudents, @Model.TotalFaculty],
                backgroundColor: [
                    'rgba(102, 126, 234, 0.8)',
                    'rgba(240, 147, 251, 0.8)'
                ],
                borderColor: [
                    '#667eea',
                    '#f093fb'
                ],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 20,
                        font: { size: 14, weight: 'bold' }
                    }
                }
            }
        }
    });

    // Overview Chart
    const overviewCtx = document.getElementById('overviewChart').getContext('2d');
    new Chart(overviewCtx, {
        type: 'bar',
        data: {
            labels: ['Courses', 'Enrollments', 'Active Courses'],
            datasets: [{
                label: 'Count',
                data: [@Model.TotalCourses, @Model.TotalEnrollments, @Model.ActiveCourses],
                backgroundColor: [
                    'rgba(79, 172, 254, 0.8)',
                    'rgba(67, 233, 123, 0.8)',
                    'rgba(245, 87, 108, 0.8)'
                ],
                borderColor: [
                    '#4facfe',
                    '#43e97b',
                    '#f5576c'
                ],
                borderWidth: 2,
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            indexAxis: 'y',
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                x: {
                    beginAtZero: true
                }
            }
        }
    });
</script>
