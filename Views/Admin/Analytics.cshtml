@model AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Analytics</li>
            </ol>
        </nav>
        <h1>Detailed Analytics</h1>
        <p class="page-subtitle">Course performance, faculty workload and academic health</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon success"><i class="fa-solid fa-calendar-check"></i></span>
            <div>
                <div class="stat-value">@Model.OverallAttendanceRate%</div>
                <div class="stat-label">Attendance (90 days)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon primary"><i class="fa-solid fa-award"></i></span>
            <div>
                <div class="stat-value">@Model.AverageGpa</div>
                <div class="stat-label">Average GPA</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon info"><i class="fa-solid fa-user-check"></i></span>
            <div>
                <div class="stat-value">@Model.ActiveStudents <small class="text-muted fw-normal" style="font-size:.85rem">/ @Model.TotalStudents</small></div>
                <div class="stat-label">Active Students</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon warning"><i class="fa-solid fa-clipboard-list"></i></span>
            <div>
                <div class="stat-value">@Model.TotalEnrollments</div>
                <div class="stat-label">Total Enrollments</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Attendance Rate by Month</h6></div>
            <div class="card-body">
                <div class="chart-container" style="height: 250px"><canvas id="attendanceChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Grade Distribution</h6></div>
            <div class="card-body">
                <div class="chart-container" style="height: 250px"><canvas id="gradeChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4" data-table>
    <div class="card-header">
        <h6 class="card-title">Course Performance</h6>
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search courses…" data-table-search />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table app-table" data-page-size="10">
            <thead>
                <tr>
                    <th data-sort="text">Course</th>
                    <th data-sort="text">Category</th>
                    <th data-sort="text">Faculty</th>
                    <th data-sort="num">Enrolled</th>
                    <th data-sort="num">Avg. Progress</th>
                    <th data-sort="num">Quizzes</th>
                    <th data-sort="num">Avg. Quiz Score</th>
                    <th data-sort="text">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.CourseStats)
                {
                    <tr>
                        <td class="fw-medium">@course.Title</td>
                        <td><span class="badge badge-soft-muted">@course.Category</span></td>
                        <td class="text-muted">@course.FacultyName</td>
                        <td>@course.EnrollmentCount</td>
                        <td>
                            <div class="d-flex align-items-center gap-2" style="min-width:120px">
                                <div class="progress flex-grow-1"><div class="progress-bar" style="width:@(course.AverageProgress)%"></div></div>
                                <span style="font-size:.82rem">@course.AverageProgress%</span>
                            </div>
                        </td>
                        <td>@course.QuizCount</td>
                        <td>@(course.AverageQuizScore > 0 ? $"{course.AverageQuizScore}%" : "—")</td>
                        <td>
                            <span class="badge @(course.IsActive ? "badge-soft-success" : "badge-soft-muted")">@(course.IsActive ? "Active" : "Inactive")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer table-pagination" data-table-pagination></div>
</div>

<div class="card">
    <div class="card-header"><h6 class="card-title">Faculty Workload</h6></div>
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr><th>Faculty</th><th>Department</th><th>Courses</th><th>Distinct Students</th></tr>
            </thead>
            <tbody>
                @if (Model.FacultyStats.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No faculty data available</td></tr>
                }
                @foreach (var f in Model.FacultyStats)
                {
                    <tr>
                        <td class="fw-medium">@f.FacultyName</td>
                        <td class="text-muted">@f.Department</td>
                        <td>@f.CourseCount</td>
                        <td>@f.StudentCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#64748b';

        const attendance = @Html.Raw(Json.Serialize(Model.AttendanceByMonth));
        new Chart(document.getElementById('attendanceChart'), {
            type: 'bar',
            data: {
                labels: attendance.map(p => p.label),
                datasets: [{ label: 'Present %', data: attendance.map(p => p.value), backgroundColor: '#16a34a', borderRadius: 6, maxBarThickness: 42 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, max: 100, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
            }
        });

        const grades = @Html.Raw(Json.Serialize(Model.GradeDistribution));
        new Chart(document.getElementById('gradeChart'), {
            type: 'doughnut',
            data: {
                labels: grades.map(p => p.label),
                datasets: [{ data: grades.map(p => p.value), backgroundColor: ['#16a34a', '#4f46e5', '#0284c7', '#d97706', '#dc2626'], borderWidth: 0 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '62%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } }
            }
        });
    </script>
}
