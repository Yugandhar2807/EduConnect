@using System.Collections.Generic;
@{
    ViewData["Title"] = "Manage Faculty";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .manage-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 30px 20px;
        margin-bottom: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 10px 30px rgba(240, 147, 251, 0.3);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .manage-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .manage-header .add-btn {
        background: white;
        color: #f093fb;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .manage-header .add-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .search-box {
        background: white;
        padding: 15px 20px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        margin-bottom: 30px;
    }

    .search-box input {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 15px;
        width: 100%;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        outline: none;
        border-color: #f093fb;
        box-shadow: 0 0 0 3px rgba(240, 147, 251, 0.1);
    }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table-container table {
        width: 100%;
        margin: 0;
    }

    .table-container thead {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .table-container th {
        padding: 18px 20px;
        font-weight: 600;
        text-align: left;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-container td {
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        color: #4a5568;
    }

    .table-container tbody tr:hover {
        background: #f7fafc;
    }

    .table-container tbody tr:last-child td {
        border-bottom: none;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-active {
        background: #c6f6d5;
        color: #22543d;
    }

    .status-inactive {
        background: #fed7d7;
        color: #742a2a;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        padding: 8px 12px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .action-btn.edit {
        background: #bee3f8;
        color: #2c5282;
    }

    .action-btn.edit:hover {
        background: #90cdf4;
        transform: translateY(-2px);
    }

    .action-btn.delete {
        background: #fed7d7;
        color: #742a2a;
    }

    .action-btn.delete:hover {
        background: #fc8181;
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #718096;
    }

    .empty-state i {
        font-size: 3rem;
        color: #cbd5e0;
        margin-bottom: 20px;
    }

    .empty-state p {
        font-size: 1.1rem;
        margin: 0;
    }

    .info-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-right: 8px;
        margin-bottom: 4px;
    }

    .info-badge.courses {
        background: #bee3f8;
        color: #2c5282;
    }

    .info-badge.students {
        background: #c6f6d5;
        color: #22543d;
    }

    }
</style>
</style>

<div class="manage-header">
    <h1>
        <i class="fas fa-chalkboard-user"></i>
        Manage Faculty
    </h1>
    <a href="@Url.Action("AddFaculty")" class="add-btn">
        <i class="fas fa-plus"></i>
        Add New Faculty
    </a>
</div>

@Html.AntiForgeryToken()

<div class="container-fluid">
    <!-- Search Box -->
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="🔍 Search by name, email, department..." onkeyup="filterTable()">
    </div>

    <!-- Faculty Table -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Courses</th>
                        <th>Students Taught</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="facultyTable">
                    @foreach (var faculty in Model)
                    {
                        <tr>
                            <td style="font-weight: 500;">@faculty.FullName</td>
                            <td>@faculty.Email</td>
                            <td>@faculty.Department</td>
                            <td>
                                <span class="info-badge courses">
                                    <i class="fas fa-book"></i> @faculty.CourseCount
                                </span>
                            </td>
                            <td>
                                <span class="info-badge students">
                                    <i class="fas fa-users"></i> @faculty.StudentCount
                                </span>
                            </td>
                            <td>
                                <span class="status-badge @(faculty.IsActive ? "status-active" : "status-inactive")">
                                    @(faculty.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("EditFaculty", new { id = faculty.Id })" class="action-btn edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <button type="button" class="action-btn delete" onclick="confirmDelete('@faculty.Id', 'faculty')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-user-tie"></i>
            <p>No faculty members found. <a href="@Url.Action("AddFaculty")" style="color: #f093fb; text-decoration: none; font-weight: 600;">Add your first faculty member</a></p>
        </div>
    }

    <!-- Back Button -->
    <div style="margin-top: 40px; margin-bottom: 40px;">
        <a href="@Url.Action("Dashboard")" class="btn btn-outline-primary" style="border-radius: 10px; padding: 10px 30px;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<script>
    function filterTable() {
        const input = document.getElementById('searchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('facultyTable');
        const rows = table.getElementsByTagName('tr');

        for (let i = 0; i < rows.length; i++) {
            const text = rows[i].textContent || rows[i].innerText;
            rows[i].style.display = text.toLowerCase().includes(filter) ? '' : 'none';
        }
    }

    function confirmDelete(id, type) {
        if (confirm('Are you sure you want to delete this faculty member?')) {
            fetch(`/Admin/DeleteFaculty`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${encodeURIComponent(id)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting faculty. Check console for details.');
            });
        }
    }
</script>
