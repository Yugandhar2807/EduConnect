@model List<FacultyListItemViewModel>
@{
    ViewData["Title"] = "Manage Faculty";
}

<div class="page-header">
    <div>
        <h1>Faculty</h1>
        <p class="page-subtitle">@Model.Count faculty member@(Model.Count == 1 ? "" : "s") registered</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="AddFaculty"><i class="fa-solid fa-user-plus me-2"></i>Add Faculty</a>
    </div>
</div>

<div class="card" data-table>
    <div class="card-header">
        <h6 class="card-title">All Faculty</h6>
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search faculty…" data-table-search />
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
            <h5>No faculty yet</h5>
            <p>Add your first faculty member to start creating courses.</p>
            <a class="btn btn-primary" asp-action="AddFaculty"><i class="fa-solid fa-user-plus me-2"></i>Add Faculty</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table" data-page-size="10">
                <thead>
                    <tr>
                        <th data-sort="text">Name</th>
                        <th data-sort="text">Email</th>
                        <th data-sort="text">Department</th>
                        <th data-sort="num">Courses</th>
                        <th data-sort="num">Students</th>
                        <th data-sort="date">Registered</th>
                        <th data-sort="text">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr id="faculty-row-@f.Id">
                            <td class="fw-medium">@f.FullName</td>
                            <td class="text-muted">@f.Email</td>
                            <td><span class="badge badge-soft-muted">@(string.IsNullOrEmpty(f.Department) ? "—" : f.Department)</span></td>
                            <td>@f.CourseCount</td>
                            <td>@f.StudentCount</td>
                            <td class="text-muted" data-value="@f.RegisteredDate.ToString("yyyy-MM-dd")">@f.RegisteredDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(f.IsActive ? "badge-soft-success" : "badge-soft-danger") status-badge">@(f.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-action="EditFaculty" asp-route-id="@f.Id" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <button type="button" class="btn btn-outline-secondary toggle-status-btn" data-id="@f.Id" title="Activate / Deactivate"><i class="fa-solid fa-power-off"></i></button>
                                    <button type="button" class="btn btn-outline-danger delete-btn" data-id="@f.Id" data-name="@f.FullName" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer table-pagination" data-table-pagination></div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                App.confirm('Delete faculty member "' + btn.dataset.name + '"? All of their courses, quizzes and materials will be removed permanently.', function () {
                    fetch('@Url.Action("DeleteFaculty")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': App.token() },
                        body: 'id=' + encodeURIComponent(btn.dataset.id)
                    })
                    .then(r => r.json())
                    .then(function (data) {
                        if (data.success) {
                            App.toast(data.message, 'success');
                            setTimeout(() => location.reload(), 700);
                        } else {
                            App.toast(data.message || 'Delete failed', 'error');
                        }
                    })
                    .catch(() => App.toast('Delete failed — please try again.', 'error'));
                });
            });
        });

        document.querySelectorAll('.toggle-status-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                fetch('@Url.Action("ToggleStudentStatus")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': App.token() },
                    body: 'id=' + encodeURIComponent(btn.dataset.id)
                })
                .then(r => r.json())
                .then(function (data) {
                    if (data.success) {
                        const badge = document.querySelector('#faculty-row-' + btn.dataset.id + ' .status-badge');
                        badge.textContent = data.isActive ? 'Active' : 'Inactive';
                        badge.className = 'badge status-badge ' + (data.isActive ? 'badge-soft-success' : 'badge-soft-danger');
                        App.toast('Account is now ' + (data.isActive ? 'active' : 'inactive') + '.', 'success');
                    }
                })
                .catch(() => App.toast('Could not update status.', 'error'));
            });
        });
    </script>
}
