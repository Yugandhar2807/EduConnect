@model List<StudentListItemViewModel>
@{
    ViewData["Title"] = "Manage Students";
}

<div class="page-header">
    <div>
        <h1>Students</h1>
        <p class="page-subtitle">@Model.Count student account@(Model.Count == 1 ? "" : "s") registered</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="AddStudent"><i class="fa-solid fa-user-plus me-2"></i>Add Student</a>
    </div>
</div>

<div class="card" data-table>
    <div class="card-header">
        <h6 class="card-title">All Students</h6>
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search students…" data-table-search />
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-user-graduate"></i></div>
            <h5>No students yet</h5>
            <p>Add your first student account to get started.</p>
            <a class="btn btn-primary" asp-action="AddStudent"><i class="fa-solid fa-user-plus me-2"></i>Add Student</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table" data-page-size="10">
                <thead>
                    <tr>
                        <th data-sort="text">Name</th>
                        <th data-sort="text">Email</th>
                        <th>Phone</th>
                        <th data-sort="num">Courses</th>
                        <th data-sort="num">Avg. Progress</th>
                        <th data-sort="date">Registered</th>
                        <th data-sort="text">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr id="student-row-@student.Id">
                            <td class="fw-medium">@student.FullName</td>
                            <td class="text-muted">@student.Email</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(student.PhoneNumber) ? "—" : student.PhoneNumber)</td>
                            <td>@student.EnrollmentCount</td>
                            <td>
                                <div class="d-flex align-items-center gap-2" style="min-width:110px">
                                    <div class="progress flex-grow-1"><div class="progress-bar" style="width:@(student.AverageProgress)%"></div></div>
                                    <span style="font-size:.82rem">@student.AverageProgress%</span>
                                </div>
                            </td>
                            <td class="text-muted" data-value="@student.RegisteredDate.ToString("yyyy-MM-dd")">@student.RegisteredDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(student.IsActive ? "badge-soft-success" : "badge-soft-danger") status-badge">@(student.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-action="EditStudent" asp-route-id="@student.Id" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <button type="button" class="btn btn-outline-secondary toggle-status-btn" data-id="@student.Id" title="Activate / Deactivate"><i class="fa-solid fa-power-off"></i></button>
                                    <button type="button" class="btn btn-outline-danger delete-btn" data-id="@student.Id" data-name="@student.FullName" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer table-pagination" data-table-pagination></div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                App.confirm('Delete student "' + btn.dataset.name + '"? All of their enrollments, results and records will be removed permanently.', function () {
                    fetch('@Url.Action("DeleteStudent")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': App.token() },
                        body: 'id=' + encodeURIComponent(btn.dataset.id)
                    })
                    .then(r => r.json())
                    .then(function (data) {
                        if (data.success) {
                            App.toast(data.message, 'success');
                            setTimeout(() => location.reload(), 700);
                        } else {
                            App.toast(data.message || 'Delete failed', 'error');
                        }
                    })
                    .catch(() => App.toast('Delete failed — please try again.', 'error'));
                });
            });
        });

        document.querySelectorAll('.toggle-status-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                fetch('@Url.Action("ToggleStudentStatus")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': App.token() },
                    body: 'id=' + encodeURIComponent(btn.dataset.id)
                })
                .then(r => r.json())
                .then(function (data) {
                    if (data.success) {
                        const badge = document.querySelector('#student-row-' + btn.dataset.id + ' .status-badge');
                        badge.textContent = data.isActive ? 'Active' : 'Inactive';
                        badge.className = 'badge status-badge ' + (data.isActive ? 'badge-soft-success' : 'badge-soft-danger');
                        App.toast('Account is now ' + (data.isActive ? 'active' : 'inactive') + '.', 'success');
                    }
                })
                .catch(() => App.toast('Could not update status.', 'error'));
            });
        });
    </script>
}
