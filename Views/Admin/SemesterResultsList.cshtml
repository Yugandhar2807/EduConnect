@model IEnumerable<EduConnect.Models.SemesterResult>

@{
    ViewData["Title"] = "Semester Results List";
}

<div class="container mt-4">
    <h1 class="mb-3">
        <i class="fas fa-list me-2"></i>Semester Results
    </h1>

    <div class="mb-3">
        <a href="@Url.Action("CreateSemesterResult")" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add New Result
        </a>
        <a href="@Url.Action("ManageSemesterResults")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Student Name</th>
                        <th>Semester</th>
                        <th>Course Name</th>
                        <th>Marks</th>
                        <th>Grade</th>
                        <th>GPA</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@result.Student?.FullName</strong>
                                    <br />
                                    <small class="text-muted">@result.Student?.Email</small>
                                </td>
                                <td>@result.Semester</td>
                                <td>@result.CourseName</td>
                                <td>
                                    <strong>@result.MarksObtained</strong>/100
                                </td>
                                <td>
                                    <span class="badge bg-info">@result.Grade</span>
                                </td>
                                <td>
                                    @{
                                        decimal gpaValue = result.GPA;
                                    }
                                    @if (gpaValue >= 3.8m)
                                    {
                                        <span class="badge bg-success">@result.GPA</span>
                                    }
                                    else if (gpaValue >= 3.0m)
                                    {
                                        <span class="badge bg-info">@result.GPA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@result.GPA</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(result.Remarks) ? "-" : result.Remarks)</td>
                                <td>
                                    <a href="@Url.Action("EditSemesterResult", new { id = result.Id })" class="btn btn-sm btn-info">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@result.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            <!-- Delete Modal -->
                            <div class="modal fade" id="deleteModal_@result.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Delete Semester Result</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            Are you sure you want to delete this semester result for <strong>@result.Student?.FullName</strong>?
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <form action="@Url.Action("DeleteSemesterResult")" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@result.Id" />
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle me-2"></i>No semester results found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
