@model List<SemesterResult>
@{
    ViewData["Title"] = "Semester Results";
    var students = (IList<ApplicationUser>)ViewBag.Students;
    var semesters = (string[])ViewBag.Semesters;
    string? selectedStudent = ViewBag.StudentId;
    string? selectedSemester = ViewBag.Semester;
}

<div class="page-header">
    <div>
        <h1>Semester Results</h1>
        <p class="page-subtitle">Record and manage official semester grades</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="CreateSemesterResult"><i class="fa-solid fa-plus me-2"></i>Add Result</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="SemesterResultsList" class="row g-2 align-items-end">
            <div class="col-sm-4 col-lg-3">
                <label class="form-label">Student</label>
                <select name="studentId" class="form-select form-select-sm">
                    <option value="">All students</option>
                    @foreach (var s in students.OrderBy(s => s.FullName))
                    {
                        <option value="@s.Id" selected="@(s.Id == selectedStudent)">@(s.FullName ?? s.Email)</option>
                    }
                </select>
            </div>
            <div class="col-sm-3 col-lg-2">
                <label class="form-label">Semester</label>
                <select name="semester" class="form-select form-select-sm">
                    <option value="">All semesters</option>
                    @foreach (var sem in semesters)
                    {
                        <option value="@sem" selected="@(sem == selectedSemester)">@sem</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-filter me-1"></i>Filter</button>
                <a class="btn btn-sm btn-outline-secondary" asp-action="SemesterResultsList">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card" data-table>
    <div class="card-header">
        <h6 class="card-title">@Model.Count result@(Model.Count == 1 ? "" : "s")</h6>
        <div class="table-search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search results…" data-table-search />
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-award"></i></div>
            <h5>No results found</h5>
            <p>No semester results match the current filters. Add one to get started.</p>
            <a class="btn btn-primary" asp-action="CreateSemesterResult"><i class="fa-solid fa-plus me-2"></i>Add Result</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table" data-page-size="12">
                <thead>
                    <tr>
                        <th data-sort="text">Student</th>
                        <th data-sort="text">Semester</th>
                        <th data-sort="text">Course</th>
                        <th data-sort="num">Marks</th>
                        <th data-sort="text">Grade</th>
                        <th data-sort="num">GPA</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        var gradeBadge = result.Grade switch
                        {
                            "A" => "badge-soft-success",
                            "B" => "badge-soft-primary",
                            "C" => "badge-soft-info",
                            "D" => "badge-soft-warning",
                            _ => "badge-soft-danger",
                        };
                        <tr>
                            <td class="fw-medium">@(result.Student?.FullName ?? result.Student?.Email ?? "Unknown")</td>
                            <td class="text-muted">@result.Semester</td>
                            <td>@result.CourseName</td>
                            <td>@result.MarksObtained.ToString("0.#")</td>
                            <td><span class="badge @gradeBadge">@result.Grade</span></td>
                            <td>@result.GPA.ToString("0.0")</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(result.Remarks) ? "—" : result.Remarks)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-action="EditSemesterResult" asp-route-id="@result.Id" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                    <form asp-action="DeleteSemesterResult" asp-route-id="@result.Id" method="post" class="d-inline"
                                          data-confirm="Delete this semester result for @(result.Student?.FullName ?? "this student")?">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer table-pagination" data-table-pagination></div>
    }
</div>
