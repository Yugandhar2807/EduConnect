@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div>
        <h1>Admin Dashboard</h1>
        <p class="page-subtitle">Institution-wide overview and activity</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-primary" asp-action="DownloadStudentData"><i class="fa-solid fa-file-excel me-2"></i>Export Excel</a>
        <a class="btn btn-primary" asp-action="Analytics"><i class="fa-solid fa-chart-line me-2"></i>Detailed Analytics</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon primary"><i class="fa-solid fa-user-graduate"></i></span>
            <div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Students</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon info"><i class="fa-solid fa-chalkboard-user"></i></span>
            <div>
                <div class="stat-value">@Model.TotalFaculty</div>
                <div class="stat-label">Faculty Members</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon success"><i class="fa-solid fa-book-open"></i></span>
            <div>
                <div class="stat-value">@Model.ActiveCourses <small class="text-muted fw-normal" style="font-size:.85rem">/ @Model.TotalCourses</small></div>
                <div class="stat-label">Active Courses</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card">
            <span class="stat-icon warning"><i class="fa-solid fa-clipboard-list"></i></span>
            <div>
                <div class="stat-value">@Model.TotalEnrollments</div>
                <div class="stat-label">Enrollments</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Enrollment Trend (last 6 months)</h6></div>
            <div class="card-body">
                <div class="chart-container" style="height: 280px">
                    <canvas id="enrollmentTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Learning Health</h6></div>
            <div class="card-body d-flex flex-column gap-3">
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted" style="font-size:.87rem">Average student progress</span>
                        <span class="fw-semibold">@Model.AverageStudentProgress%</span>
                    </div>
                    <div class="progress"><div class="progress-bar" style="width:@(Model.AverageStudentProgress)%"></div></div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted" style="font-size:.87rem">Quiz pass rate</span>
                        <span class="fw-semibold">@Model.QuizPassRate%</span>
                    </div>
                    <div class="progress"><div class="progress-bar bg-success" style="width:@(Model.QuizPassRate)%"></div></div>
                </div>
                <div class="mt-2">
                    <div class="chart-container" style="height: 170px">
                        <canvas id="usersByRoleChart"></canvas>
                    </div>
                </div>
                <div class="text-center text-muted" style="font-size:.83rem">
                    @Model.TotalQuizAttempts quiz attempts recorded
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Top Courses by Enrollment</h6></div>
            <div class="card-body">
                @if (Model.TopCoursesByEnrollment.Count == 0)
                {
                    <div class="empty-state py-4">
                        <div class="empty-icon"><i class="fa-solid fa-book"></i></div>
                        <h5>No courses yet</h5>
                        <p>Courses will appear here once faculty create them.</p>
                    </div>
                }
                else
                {
                    <div class="chart-container" style="height: 260px">
                        <canvas id="topCoursesChart"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h6 class="card-title">Recent Activity</h6></div>
            <div class="table-responsive">
                <table class="table app-table">
                    <thead>
                        <tr><th>Student</th><th>Activity</th><th>Detail</th><th>When</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentQuizAttempts)
                        {
                            <tr>
                                <td class="fw-medium">@item.StudentName</td>
                                <td class="text-muted">Attempted <span class="fw-medium text-body">@item.Target</span></td>
                                <td>
                                    <span class="badge @(item.Success == true ? "badge-soft-success" : "badge-soft-danger")">@item.Detail</span>
                                </td>
                                <td class="text-muted">@item.OccurredAt.ToString("dd MMM, HH:mm")</td>
                            </tr>
                        }
                        @foreach (var item in Model.RecentEnrollments)
                        {
                            <tr>
                                <td class="fw-medium">@item.StudentName</td>
                                <td class="text-muted">Enrolled in <span class="fw-medium text-body">@item.Target</span></td>
                                <td><span class="badge badge-soft-info">New</span></td>
                                <td class="text-muted">@item.OccurredAt.ToString("dd MMM, HH:mm")</td>
                            </tr>
                        }
                        @if (Model.RecentQuizAttempts.Count == 0 && Model.RecentEnrollments.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No recent activity</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#64748b';

        const trend = @Html.Raw(Json.Serialize(Model.EnrollmentsByMonth));
        new Chart(document.getElementById('enrollmentTrendChart'), {
            type: 'line',
            data: {
                labels: trend.map(p => p.label),
                datasets: [{
                    label: 'Enrollments',
                    data: trend.map(p => p.value),
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79,70,229,.08)',
                    fill: true,
                    tension: .35,
                    pointBackgroundColor: '#4f46e5',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
            }
        });

        const roles = @Html.Raw(Json.Serialize(Model.UsersByRole));
        new Chart(document.getElementById('usersByRoleChart'), {
            type: 'doughnut',
            data: {
                labels: roles.map(p => p.label),
                datasets: [{ data: roles.map(p => p.value), backgroundColor: ['#4f46e5', '#0284c7'], borderWidth: 0 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } } }
            }
        });

        const topCourses = @Html.Raw(Json.Serialize(Model.TopCoursesByEnrollment));
        if (topCourses.length) {
            new Chart(document.getElementById('topCoursesChart'), {
                type: 'bar',
                data: {
                    labels: topCourses.map(p => p.label),
                    datasets: [{ data: topCourses.map(p => p.value), backgroundColor: '#4f46e5', borderRadius: 6, maxBarThickness: 26 }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }, y: { grid: { display: false } } }
                }
            });
        }
    </script>
}
