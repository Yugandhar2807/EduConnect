@model AddFacultyViewModel

@{
    ViewData["Title"] = "Add New Faculty";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .form-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 30px 20px;
        margin-bottom: 30px;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 10px 30px rgba(240, 147, 251, 0.3);
    }

    .form-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .form-container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #2d3748;
        font-size: 0.95rem;
    }

    .form-group input {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-group input:focus {
        outline: none;
        border-color: #f093fb;
        box-shadow: 0 0 0 3px rgba(240, 147, 251, 0.1);
    }

    .form-group input::placeholder {
        color: #cbd5e0;
    }

    .input-icon {
        position: relative;
    }

    .input-icon i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #cbd5e0;
        font-size: 1rem;
        pointer-events: none;
    }

    .input-icon input {
        padding-left: 45px;
    }

    .form-group input.error {
        border-color: #f56565;
    }

    .error-message {
        color: #f56565;
        font-size: 0.85rem;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 35px;
    }

    .btn {
        flex: 1;
        padding: 13px 20px;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn.submit {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        text-decoration: none;
    }

    .btn.submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(240, 147, 251, 0.3);
    }

    .btn.cancel {
        background: #e2e8f0;
        color: #4a5568;
        text-decoration: none;
    }

    .btn.cancel:hover {
        background: #cbd5e0;
        transform: translateY(-2px);
    }

    .password-requirements {
        background: #edf2f7;
        border-left: 4px solid #f093fb;
        padding: 15px;
        border-radius: 6px;
        margin-top: 15px;
        font-size: 0.85rem;
        color: #4a5568;
    }

    .password-requirements li {
        margin: 5px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .password-requirements .check {
        color: #48bb78;
    }

    .password-requirements .cross {
        color: #f56565;
    }

    .success-message {
        background: #c6f6d5;
        border-left: 4px solid #48bb78;
        color: #22543d;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>

<div class="form-header">
    <h1>
        <i class="fas fa-user-tie"></i>
        Add New Faculty
    </h1>
</div>

<div class="container-fluid">
    <div class="form-container">
        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                <i class="fas fa-check-circle"></i>
                @ViewBag.Success
            </div>
        }

        <form asp-action="AddFaculty" asp-controller="Admin" method="post" class="needs-validation" novalidate>
            <!-- Full Name -->
            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <div class="input-icon">
                    <i class="fas fa-user"></i>
                    <input asp-for="FullName" type="text" placeholder="Enter faculty's full name" required>
                </div>
                <span asp-validation-for="FullName" class="error-message"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <div class="input-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="Enter faculty's email" required>
                </div>
                <span asp-validation-for="Email" class="error-message"></span>
            </div>

            <!-- Department -->
            <div class="form-group">
                <label asp-for="Department">Department</label>
                <div class="input-icon">
                    <i class="fas fa-building"></i>
                    <input asp-for="Department" type="text" placeholder="e.g., Computer Science, Mathematics" required>
                </div>
                <span asp-validation-for="Department" class="error-message"></span>
            </div>

            <!-- Phone Number -->
            <div class="form-group">
                <label asp-for="PhoneNumber">Phone Number</label>
                <div class="input-icon">
                    <i class="fas fa-phone"></i>
                    <input asp-for="PhoneNumber" type="tel" placeholder="Enter faculty's phone number">
                </div>
                <span asp-validation-for="PhoneNumber" class="error-message"></span>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" type="password" placeholder="Enter password" id="passwordInput" required>
                </div>
                <span asp-validation-for="Password" class="error-message"></span>
                <div class="password-requirements">
                    <strong style="display: block; margin-bottom: 8px;">Password Requirements:</strong>
                    <ul style="margin: 0; padding-left: 0; list-style: none;">
                        <li>
                            <span id="lengthCheck" class="cross">✗</span>
                            At least 8 characters
                        </li>
                        <li>
                            <span id="uppercaseCheck" class="cross">✗</span>
                            One uppercase letter
                        </li>
                        <li>
                            <span id="lowercaseCheck" class="cross">✗</span>
                            One lowercase letter
                        </li>
                        <li>
                            <span id="numberCheck" class="cross">✗</span>
                            One number
                        </li>
                        <li>
                            <span id="specialCheck" class="cross">✗</span>
                            One special character (!@@#$%^&*)
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn submit">
                    <i class="fas fa-save"></i>
                    Create Faculty
                </button>
                <a href="@Url.Action("ManageFaculty")" class="btn cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    const passwordInput = document.getElementById('passwordInput');

    if (passwordInput) {
        passwordInput.addEventListener('input', function() {
            const password = this.value;

            // Check length
            const length = password.length >= 8;
            document.getElementById('lengthCheck').textContent = length ? '✓' : '✗';
            document.getElementById('lengthCheck').className = length ? 'check' : 'cross';

            // Check uppercase
            const uppercase = /[A-Z]/.test(password);
            document.getElementById('uppercaseCheck').textContent = uppercase ? '✓' : '✗';
            document.getElementById('uppercaseCheck').className = uppercase ? 'check' : 'cross';

            // Check lowercase
            const lowercase = /[a-z]/.test(password);
            document.getElementById('lowercaseCheck').textContent = lowercase ? '✓' : '✗';
            document.getElementById('lowercaseCheck').className = lowercase ? 'check' : 'cross';

            // Check number
            const number = /[0-9]/.test(password);
            document.getElementById('numberCheck').textContent = number ? '✓' : '✗';
            document.getElementById('numberCheck').className = number ? 'check' : 'cross';

            // Check special character
            const special = /[!@@#$%^&*]/.test(password);
            document.getElementById('specialCheck').textContent = special ? '✓' : '✗';
            document.getElementById('specialCheck').className = special ? 'check' : 'cross';
        });
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
