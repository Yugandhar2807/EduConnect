@model AddFacultyViewModel
@{
    ViewData["Title"] = "Add Faculty";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="ManageFaculty">Faculty</a></li>
                <li class="breadcrumb-item active">Add Faculty</li>
            </ol>
        </nav>
        <h1>Add Faculty Member</h1>
        <p class="page-subtitle">Create a new faculty account</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="AddFaculty" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. Sarah Mitchell" autofocus />
                        <span asp-validation-for="FullName"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="faculty@example.com" />
                            <span asp-validation-for="Email"></span>
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
                        <span asp-validation-for="Department"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password"></span>
                        <div class="form-text">At least 8 characters with upper &amp; lower case, a number and a symbol.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-user-plus me-2"></i>Create Faculty</button>
                        <a class="btn btn-outline-secondary" asp-action="ManageFaculty">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
