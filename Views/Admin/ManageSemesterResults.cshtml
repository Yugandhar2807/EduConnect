@{
    ViewData["Title"] = "Manage Semester Results";
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="fas fa-graduation-cap me-2"></i>Manage Semester Results
    </h1>

    <div class="row mb-4">
        <div class="col-md-6">
            <a href="@Url.Action("CreateSemesterResult")" class="btn btn-primary btn-lg w-100">
                <i class="fas fa-plus me-2"></i>Add New Semester Result
            </a>
        </div>
        <div class="col-md-6">
            <a href="@Url.Action("SemesterResultsList")" class="btn btn-secondary btn-lg w-100">
                <i class="fas fa-list me-2"></i>View All Results
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Search</h5>
                    <form action="@Url.Action("SemesterResultsList")" method="get">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="studentId" class="form-label">Student:</label>
                                <select class="form-select" id="studentId" name="studentId">
                                    <option value="">-- All Students --</option>
                                    @foreach (var student in ViewBag.Students)
                                    {
                                        <option value="@student.Id">@student.FullName (@student.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="semester" class="form-label">Semester:</label>
                                <select class="form-select" id="semester" name="semester">
                                    <option value="">-- All Semesters --</option>
                                    <option value="Fall 2025">Fall 2025</option>
                                    <option value="Spring 2026">Spring 2026</option>
                                    <option value="Summer 2026">Summer 2026</option>
                                    <option value="Fall 2026">Fall 2026</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Search
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Information</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-info-circle me-2 text-info"></i> Manage all student semester results</li>
                        <li><i class="fas fa-info-circle me-2 text-info"></i> Track grades and GPA</li>
                        <li><i class="fas fa-info-circle me-2 text-info"></i> Multiple semesters support</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
